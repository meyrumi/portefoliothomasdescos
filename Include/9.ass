Dialogue: 0,0:00:10.46,0:00:20.00,Default,,0,0,0,,{\pos(962,1016)}Traduction : Solki, BigPacos\NCorrection : Yo-3DS, Natsufuyu, Nono\NCompilation SRT : Calimélo
Dialogue: 0,0:00:44.46,0:00:45.86,Default,,0,0,0,,{\pos(962,1016)}On continue avec l'actualité...
Dialogue: 0,0:00:46.38,0:00:47.34,Default,,0,0,0,,{\pos(962,1016)}Hier soir...
Dialogue: 0,0:00:47.34,0:00:50.52,Default,,0,0,0,,{\pos(962,1016)}...un énorme OVNI a été repéré.
Dialogue: 0,0:00:54.68,0:00:57.08,Default,,0,0,0,,{\pos(962,1016)}Selon certains témoins,
Dialogue: 0,0:00:57.08,0:01:00.90,Default,,0,0,0,,{\pos(962,1016)}...sa largeur est estimée à environ 300 mètres...
Dialogue: 0,0:01:00.90,0:01:04.10,Default,,0,0,0,,{\pos(962,1016)}... et certains d'entre eux affirment "qu'il pourrait s'agir d'un OVNI".
Dialogue: 0,0:01:05.06,0:01:08.36,Default,,0,0,0,,{\pos(962,1016)}Ouah Nathan, il semble y avoir des nouvelles intéressantes !
Dialogue: 0,0:01:09.02,0:01:10.84,Default,,0,0,0,,{\pos(962,1016)}Un OVNI de 300 mètres de long ?
Dialogue: 0,0:01:11.38,0:01:12.56,Default,,0,0,0,,{\pos(962,1016)}Impossible !
Dialogue: 0,0:01:13.76,0:01:16.14,Default,,0,0,0,,{\pos(962,1016)}C'est le mystère parfait !
Dialogue: 0,0:01:16.30,0:01:19.50,Default,,0,0,0,,{\pos(962,1016)}Quelque chose qui ne peut qu'être passionnant !
Dialogue: 0,0:01:19.50,0:01:21.84,Default,,0,0,0,,{\pos(962,1016)}Eh bien, si les Yo-kai existent...
Dialogue: 0,0:01:21.84,0:01:24.68,Default,,0,0,0,,{\pos(962,1016)}... je suppose que les extraterrestres existent aussi.
Dialogue: 0,0:01:26.70,0:01:31.86,Default,,0,0,0,,{\pos(962,1016)}Je me demande s'il y a vraiment un vaisseau extraterrestre plus grand qu'un terrain de football.
Dialogue: 0,0:01:34.42,0:01:35.56,Default,,0,0,0,,{\pos(962,1016)}Bien sûr que non.
Dialogue: 0,0:01:35.56,0:01:38.74,Default,,0,0,0,,{\pos(962,1016)}Tu ne changeras jamais, Nathan !
Dialogue: 0,0:01:38.74,0:01:41.30,Default,,0,0,0,,{\pos(962,1016)}"Ce n'est que de la science-fiction !"
Dialogue: 0,0:01:41.30,0:01:44.22,Default,,0,0,0,,{\pos(962,1016)}"C'est tout à fait normal !"
Dialogue: 0,0:01:46.50,0:01:51.26,Default,,0,0,0,,{\pos(962,1016)}Dit l'aveugle qui croit à tout ce qui est dit à la télévision et sur Internet ?
Dialogue: 0,0:01:51.64,0:01:54.40,Default,,0,0,0,,{\pos(962,1016)}A-Attends, tu as tort !
Dialogue: 0,0:01:54.40,0:01:57.94,Default,,0,0,0,,{\pos(962,1016)}Comment peux-tu dire quelque chose comme ça à mon sujet ?
Dialogue: 0,0:01:57.94,0:01:59.04,Default,,0,0,0,,{\pos(962,1016)}Hein ?
Dialogue: 0,0:01:59.04,0:02:02.32,Default,,0,0,0,,{\pos(962,1016)}Dit le gars qui ne connait pas grand chose en réalité !
Dialogue: 0,0:02:02.36,0:02:04.24,Default,,0,0,0,,{\pos(962,1016)}Tu es inutile sans ton Yo-kai Pad !
Dialogue: 0,0:02:04.24,0:02:06.70,Default,,0,0,0,,{\pos(962,1016)}Et complètement dépendant de Yo-kaipedia !
Dialogue: 0,0:02:06.90,0:02:09.14,Default,,0,0,0,,{\pos(962,1016)}Euh... Q-Quoi...
Dialogue: 0,0:02:09.18,0:02:11.16,Default,,0,0,0,,{\pos(962,1016)}Que viens-tu de dire ?!
Dialogue: 0,0:02:12.80,0:02:16.70,Default,,0,0,0,,{\pos(962,1016)}Pourquoi ne changes-tu pas ton nom en « Whis-pad » ?
Dialogue: 0,0:02:16.78,0:02:18.12,Default,,0,0,0,,{\pos(962,1016)}Alors toi, tu vas voir !
Dialogue: 0,0:02:27.72,0:02:29.54,Default,,0,0,0,,{\pos(962,1016)}Next ! Next ! Next ! Next !
Dialogue: 0,0:02:29.54,0:02:31.82,Default,,0,0,0,,{\pos(962,1016)}HarMIAOUny !
Dialogue: 0,0:02:31.82,0:02:32.82,Default,,0,0,0,,{\pos(962,1016)}Har
Dialogue: 0,0:02:32.82,0:02:33.86,Default,,0,0,0,,{\pos(962,1016)}MIAOU
Dialogue: 0,0:02:33.88,0:02:34.83,Default,,0,0,0,,{\pos(962,1016)}ny !
Dialogue: 0,0:02:34.94,0:02:36.46,Default,,0,0,0,,{\pos(962,1016)}HarMIAOUny...
Dialogue: 0,0:02:41.38,0:02:42.58,Default,,0,0,0,,{\pos(962,1016)}Chers fans,
Dialogue: 0,0:02:42.64,0:02:45.94,Default,,0,0,0,,{\pos(962,1016)}pour ce concert des Next HarMIAOUny aujourd’hui.
Dialogue: 0,0:02:46.02,0:02:47.16,Default,,0,0,0,,{\pos(962,1016)}Un grand merci,
Dialogue: 0,0:02:47.26,0:02:48.96,Default,,0,0,0,,{\pos(962,1016)}Merci à tous les fans, nya !
Dialogue: 0,0:02:49.06,0:02:52.34,Default,,0,0,0,,{\pos(962,1016)}Vous êtes les meilleures !!
Dialogue: 0,0:02:52.34,0:02:56.26,Default,,0,0,0,,{\pos(962,1016)}Tout le monde, unissons nos cœurs, restez à l'affût !
Dialogue: 0,0:02:56.86,0:02:57.76,Default,,0,0,0,,{\pos(962,1016)}Nya !
Dialogue: 0,0:02:58.46,0:03:00.78,Default,,0,0,0,,{\pos(962,1016)}Bien sûr, nya !
Dialogue: 0,0:03:00.78,0:03:01.62,Default,,0,0,0,,{\pos(962,1016)}Youhouu !
Dialogue: 0,0:03:02.72,0:03:03.80,Default,,0,0,0,,{\pos(962,1016)}Komajiro...
Dialogue: 0,0:03:03.80,0:03:06.70,Default,,0,0,0,,{\pos(962,1016)}C'est si bon de manger des glaces toute la journée !
Dialogue: 0,0:03:06.70,0:03:09.12,Default,,0,0,0,,{\pos(962,1016)}Tu ne t'en lasses jamais, n'est-ce pas ?
Dialogue: 0,0:03:09.12,0:03:12.18,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que tu dis ? Comme si je pouvais m'en lasser !
Dialogue: 0,0:03:12.24,0:03:14.86,Default,,0,0,0,,{\pos(962,1016)}Plus j’en mange, plus je les aime !
Dialogue: 0,0:03:16.36,0:03:21.90,Default,,0,0,0,,{\pos(962,1016)}Même les nuages ​​ressemblent à de la glace aujourd'hui !
Dialogue: 0,0:03:23.98,0:03:25.60,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que c'est ?
Dialogue: 0,0:03:44.60,0:03:45.58,Default,,0,0,0,,{\pos(962,1016)}Quoi... ?
Dialogue: 0,0:03:45.60,0:03:46.50,Default,,0,0,0,,{\pos(962,1016)}C'était quoi ça ?
Dialogue: 0,0:03:46.50,0:03:47.22,Default,,0,0,0,,{\pos(962,1016)}Bon sang !
Dialogue: 0,0:03:47.22,0:03:48.74,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que c’est que cette voix ?
Dialogue: 0,0:03:50.30,0:03:51.08,Default,,0,0,0,,{\pos(962,1016)}Quoi... ?
Dialogue: 0,0:03:55.98,0:03:56.70,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que c'est ?
Dialogue: 0,0:04:00.84,0:04:03.80,Default,,0,0,0,,{\pos(962,1016)}Qu'est ce qu’il se passe ?!
Dialogue: 0,0:04:04.24,0:04:05.80,Default,,0,0,0,,{\pos(962,1016)}Grand frère !
Dialogue: 0,0:04:05.80,0:04:07.26,Default,,0,0,0,,{\pos(962,1016)}C'est un peu bizarre... !
Dialogue: 0,0:04:07.26,0:04:09.90,Default,,0,0,0,,{\pos(962,1016)}C'EST TOURNEBOULANT !!!
Dialogue: 0,0:04:18.92,0:04:19.64,Default,,0,0,0,,{\pos(962,1016)}Quoi ?!
Dialogue: 0,0:04:21.60,0:04:23.16,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que c'est que ça ?
Dialogue: 0,0:04:24.30,0:04:26.04,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce qui vient de se passer ?
Dialogue: 0,0:04:29.04,0:04:30.86,Default,,0,0,0,,{\pos(962,1016)}Est-ce que c'est moi ?
Dialogue: 0,0:04:30.86,0:04:32.86,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que c'est ?
Dialogue: 0,0:04:32.86,0:04:34.28,Default,,0,0,0,,{\pos(962,1016)}C'est tellement bizarre !
Dialogue: 0,0:04:34.28,0:04:38.08,Default,,0,0,0,,{\pos(962,1016)}Peu importe comment on le voit, c'est totalement bizarre !
Dialogue: 0,0:04:39.20,0:04:41.98,Default,,0,0,0,,{\pos(962,1016)}Mes vêtements aussi sont bizarres...
Dialogue: 0,0:04:43.36,0:04:44.28,Default,,0,0,0,,{\pos(962,1016)}Ouah !
Dialogue: 0,0:04:44.28,0:04:47.08,Default,,0,0,0,,{\pos(962,1016)}La montre a un aspect métallique !
Dialogue: 0,0:04:47.08,0:04:49.62,Default,,0,0,0,,{\pos(962,1016)}Elle a l'air tellement cool maintenant !
