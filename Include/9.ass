Dialogue: 0,0:05:07.12,0:05:07.70,Default,,0,0,0,,{\pos(962,1016)}Come on !
Dialogue: 0,0:05:09.63,0:05:11.62,Default,,0,0,0,,{\pos(962,1016)}Vent de panique
Dialogue: 0,0:05:11.63,0:05:13.10,Default,,0,0,0,,{\pos(962,1016)}Plus de réseau, plus de tempo
Dialogue: 0,0:05:13.15,0:05:14.72,Default,,0,0,0,,{\pos(962,1016)}Whisper débarque, ta vie fait boum-boum
Dialogue: 0,0:05:14.73,0:05:16.70,Default,,0,0,0,,{\pos(962,1016)}Plus de batterie, la pendule se détraque
Dialogue: 0,0:05:16.71,0:05:18.42,Default,,0,0,0,,{\pos(962,1016)}Elle fait vroum, ton futur fait "popo" !
Dialogue: 0,0:05:18.53,0:05:20.72,Default,,0,0,0,,{\pos(962,1016)}Tu surveilles le rétro
Dialogue: 0,0:05:20.73,0:05:22.52,Default,,0,0,0,,{\pos(962,1016)}Rapide c'est comme la montée des eaux
Dialogue: 0,0:05:22.53,0:05:24.72,Default,,0,0,0,,{\pos(962,1016)}Mais l'avenir te traque et te dépasse, yo
Dialogue: 0,0:05:24.73,0:05:26.22,Default,,0,0,0,,{\pos(962,1016)}Vis encore plus vite
Dialogue: 0,0:05:26.33,0:05:29.82,Default,,0,0,0,,{\pos(962,1016)}Si le ciel se met à chanter
Dialogue: 0,0:05:29.83,0:05:33.52,Default,,0,0,0,,{\pos(962,1016)}Les nuages à danser
