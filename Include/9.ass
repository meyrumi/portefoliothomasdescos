Dialogue: 0,0:05:55.30,0:05:58.00,Default,,0,0,0,,{\pos(962,1016)}Gera Gera Po Po, Gera Gera Po
Dialogue: 0,0:05:58.00,0:06:00.00,Default,,0,0,0,,{\pos(962,1016)}C'est facile allez !
Dialogue: 0,0:06:00.00,0:06:06.00,Default,,0,0,0,,{\pos(962,1016)}Ces Yo-kai, rendent la vie bizarre
Dialogue: 0,0:06:06.10,0:06:12.00,Default,,0,0,0,,{\pos(962,1016)}Parce qu'il a, Ha ha cette Yo-kai...
Dialogue: 0,0:06:12.10,0:06:16.00,Default,,0,0,0,,{\pos(962,1016)}Yo-kai Watch !
Dialogue: 0,0:06:16.10,0:06:18.00,Default,,0,0,0,,{\pos(962,1016)}Gera Gera Po
Dialogue: 0,0:06:32.60,0:06:35.80,Default,,0,0,0,,{\pos(962,1016)}P-Posons-nous et réfléchissons à tout ça.
Dialogue: 0,0:06:35.80,0:06:36.50,Default,,0,0,0,,{\pos(962,1016)}Bien sûr.
Dialogue: 0,0:06:36.50,0:06:39.66,Default,,0,0,0,,{\pos(962,1016)}Euh... Alors j'étais allongé sur le lit...
Dialogue: 0,0:06:39.66,0:06:41.66,Default,,0,0,0,,{\pos(962,1016)}...en lisant des mangas...
Dialogue: 0,0:06:41.66,0:06:44.54,Default,,0,0,0,,{\pos(962,1016)}...et je parlais à Whisper des OVNIs...
Dialogue: 0,0:06:44.54,0:06:45.32,Default,,0,0,0,,{\pos(962,1016)}Euh, hein...
Dialogue: 0,0:06:46.04,0:06:47.14,Default,,0,0,0,,{\pos(962,1016)}Et puis...
Dialogue: 0,0:06:47.14,0:06:49.14,Default,,0,0,0,,{\pos(962,1016)}... comme toujours, Whisper était insuportable...
Dialogue: 0,0:06:49.14,0:06:50.22,Default,,0,0,0,,{\pos(962,1016)}Q-Quoi ?!
Dialogue: 0,0:06:50.22,0:06:53.00,Default,,0,0,0,,{\pos(962,1016)}"Comme toujours"?!
Dialogue: 0,0:06:53.30,0:06:56.04,Default,,0,0,0,,{\pos(962,1016)}Whisper, tu es complètement différent !
Dialogue: 0,0:06:56.04,0:06:56.80,Default,,0,0,0,,{\pos(962,1016)}Ooooh !
Dialogue: 0,0:06:56.80,0:06:58.80,Default,,0,0,0,,{\pos(962,1016)}Hé hé ! Bien sûr !
Dialogue: 0,0:06:58.80,0:07:01.46,Default,,0,0,0,,{\pos(962,1016)}Avant je ressemblais à ça...
Dialogue: 0,0:07:01.46,0:07:04.80,Default,,0,0,0,,{\pos(962,1016)}Mais maintenant, je suis devenu encore plus beau !
Dialogue: 0,0:07:08.74,0:07:12.70,Default,,0,0,0,,{\pos(962,1016)}Eh bien, maintenant que tu en parle, je suis un peu...
Dialogue: 0,0:07:12.88,0:07:15.20,Default,,0,0,0,,{\pos(962,1016)}Moi aussi, j'ai l'air un peu différent...
Dialogue: 0,0:07:15.20,0:07:17.44,Default,,0,0,0,,{\pos(962,1016)}Bien sûr, en parlant de toi, Nathan...
Dialogue: 0,0:07:17.48,0:07:21.18,Default,,0,0,0,,{\pos(962,1016)}Tu avais un visage plus joufflu... une peau plus lisse...
Dialogue: 0,0:07:21.28,0:07:25.34,Default,,0,0,0,,{\pos(962,1016)}...et une coiffure unique en forme d'aile, un peu comme ça...
Dialogue: 0,0:07:25.34,0:07:26.78,Default,,0,0,0,,{\pos(962,1016)}Aïe aïe aïe !
Dialogue: 0,0:07:26.78,0:07:28.12,Default,,0,0,0,,{\pos(962,1016)}Ça fait mal !
Dialogue: 0,0:07:30.08,0:07:31.44,Default,,0,0,0,,{\pos(962,1016)}C'est comme tu dis...
Dialogue: 0,0:07:31.44,0:07:33.28,Default,,0,0,0,,{\pos(962,1016)}...le monde physique... le monde réel...
Dialogue: 0,0:07:33.28,0:07:36.88,Default,,0,0,0,,{\pos(962,1016)}...le monde matériel... où tout est différent...
Dialogue: 0,0:07:36.88,0:07:39.54,Default,,0,0,0,,{\pos(962,1016)}Ouais... sérieusement...
Dialogue: 0,0:07:39.54,0:07:41.10,Default,,0,0,0,,{\pos(962,1016)}Quand je regarde ma main...
Dialogue: 0,0:07:41.10,0:07:44.40,Default,,0,0,0,,{\pos(962,1016)}...Je vois des rides... et de petits points...
Dialogue: 0,0:07:44.40,0:07:46.28,Default,,0,0,0,,{\pos(962,1016)}Ce sont tes pores !
Dialogue: 0,0:07:46.28,0:07:51.64,Default,,0,0,0,,{\pos(962,1016)}La peau des êtres humains a des pores qui ressemblent à des petits points !
Dialogue: 0,0:07:53.80,0:07:54.94,Default,,0,0,0,,{\pos(962,1016)}Nathan !
Dialogue: 0,0:07:55.04,0:07:57.38,Default,,0,0,0,,{\pos(962,1016)}Euh ! Ne... Ne me dis pas...
Dialogue: 0,0:07:58.04,0:07:59.06,Default,,0,0,0,,{\pos(962,1016)}Maman... !
Dialogue: 0,0:07:59.34,0:08:02.60,Default,,0,0,0,,{\pos(962,1016)}Maman apparaîtra dans...
Dialogue: 0,0:08:09.66,0:08:10.62,Default,,0,0,0,,{\pos(962,1016)}Nathan !
Dialogue: 0,0:08:12.38,0:08:15.10,Default,,0,0,0,,{\pos(962,1016)}Papa n'a plus de cirage, tu peux aller en acheter ?
Dialogue: 0,0:08:16.14,0:08:16.98,Default,,0,0,0,,{\pos(962,1016)}Euh....
Dialogue: 0,0:08:16.98,0:08:18.28,Default,,0,0,0,,{\pos(962,1016)}Tu es maman... n'est-ce pas... ?
Dialogue: 0,0:08:19.36,0:08:20.18,Default,,0,0,0,,{\pos(962,1016)}Maman...
Dialogue: 0,0:08:23.54,0:08:24.88,Default,,0,0,0,,{\pos(962,1016)}Bien....
Dialogue: 0,0:08:24.88,0:08:26.40,Default,,0,0,0,,{\pos(962,1016)}Bonjour !
Dialogue: 0,0:08:26.40,0:08:28.18,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que tu dis ?
Dialogue: 0,0:08:28.18,0:08:29.84,Default,,0,0,0,,{\pos(962,1016)}Tu y vas ou pas ?
Dialogue: 0,0:08:29.84,0:08:31.84,Default,,0,0,0,,{\pos(962,1016)}Euh... Qu'est-ce que c'était... ?
Dialogue: 0,0:08:32.08,0:08:33.12,Default,,0,0,0,,{\pos(962,1016)}Une course.
Dialogue: 0,0:08:33.86,0:08:34.84,Default,,0,0,0,,{\pos(962,1016)}Ah ! Je comprends !
Dialogue: 0,0:08:34.84,0:08:35.88,Default,,0,0,0,,{\pos(962,1016)}J'y vais bientôt !
Dialogue: 0,0:08:35.88,0:08:36.98,Default,,0,0,0,,{\pos(962,1016)}Ne t'inquiète pas, je vais y allez !
Dialogue: 0,0:08:37.04,0:08:38.30,Default,,0,0,0,,{\pos(962,1016)}Juste... donne-moi une minute.
Dialogue: 0,0:08:41.68,0:08:43.62,Default,,0,0,0,,{\pos(962,1016)}C'était quoi ça ?
Dialogue: 0,0:08:43.62,0:08:44.88,Default,,0,0,0,,{\pos(962,1016)}Quel étrange enfant.
Dialogue: 0,0:08:46.80,0:08:48.86,Default,,0,0,0,,{\pos(962,1016)}C'est quoi cette tension... ?
Dialogue: 0,0:08:48.86,0:08:50.02,Default,,0,0,0,,{\pos(962,1016)}Oui.
Dialogue: 0,0:08:50.02,0:08:53.92,Default,,0,0,0,,{\pos(962,1016)}Ta mère vient de subir un relooking des plus merveilleux, n'est-ce pas ?
Dialogue: 0,0:08:54.48,0:08:55.56,Default,,0,0,0,,{\pos(962,1016)}Relooking ?
Dialogue: 0,0:08:55.56,0:08:56.20,Default,,0,0,0,,{\pos(962,1016)}Oui.
Dialogue: 0,0:08:57.98,0:08:59.28,Default,,0,0,0,,{\pos(962,1016)}Que vas-tu faire ?
Dialogue: 0,0:09:02.76,0:09:04.80,Default,,0,0,0,,{\pos(962,1016)}Eh bien... si ça doit être comme ça...
Dialogue: 0,0:09:06.22,0:09:07.28,Default,,0,0,0,,{\pos(962,1016)}Je peux l'accepter.
Dialogue: 0,0:09:07.28,0:09:08.40,Default,,0,0,0,,{\pos(962,1016)}Pensée positive !
Dialogue: 0,0:09:08.56,0:09:09.92,Default,,0,0,0,,{\pos(962,1016)}Pensée positive !
Dialogue: 0,0:09:10.04,0:09:15.46,Default,,0,0,0,,{\pos(962,1016)}Papa apparaîtra dans...
Dialogue: 0,0:09:24.80,0:09:25.64,Default,,0,0,0,,{\pos(962,1016)}Je suis rentré !
Dialogue: 0,0:09:26.84,0:09:27.98,Default,,0,0,0,,{\pos(962,1016)}Content de te revoir !
Dialogue: 0,0:09:28.82,0:09:29.80,Default,,0,0,0,,{\pos(962,1016)}Bienvenue à la maison !
Dialogue: 0,0:09:30.80,0:09:32.72,Default,,0,0,0,,{\pos(962,1016)}C'est... Papa, n'est-ce pas ?
Dialogue: 0,0:09:32.72,0:09:34.58,Default,,0,0,0,,{\pos(962,1016)}On dirait que c'est le cas.
Dialogue: 0,0:09:34.62,0:09:35.64,Default,,0,0,0,,{\pos(962,1016)}Bienvenue !
Dialogue: 0,0:09:36.14,0:09:38.44,Default,,0,0,0,,{\pos(962,1016)}Le chef du département a soudainement voulu arrêter de jouer.
Dialogue: 0,0:09:39.38,0:09:41.84,Default,,0,0,0,,{\pos(962,1016)}Il n'était pas d'humeur, donc je suis parti.
Dialogue: 0,0:09:41.84,0:09:44.46,Default,,0,0,0,,{\pos(962,1016)}Attends, alors tu es parti en milieu du match de golf ?
Dialogue: 0,0:09:44.46,0:09:46.46,Default,,0,0,0,,{\pos(962,1016)}Assure-toi que sa femme ne finisse pas par t'en vouloir.
Dialogue: 0,0:09:46.46,0:09:48.08,Default,,0,0,0,,{\pos(962,1016)}Je reviens !
Dialogue: 0,0:09:48.10,0:09:48.90,Default,,0,0,0,,{\pos(962,1016)}À plus tard !
Dialogue: 0,0:09:48.90,0:09:49.54,Default,,0,0,0,,{\pos(962,1016)}Prends soin de toi !
Dialogue: 0,0:09:54.88,0:09:57.46,Default,,0,0,0,,{\pos(962,1016)}Il a dit qu'il était parti jouer au golf ?
Dialogue: 0,0:09:57.46,0:10:00.92,Default,,0,0,0,,{\pos(962,1016)}Ce n'est pas être le genre de choses dont il parle habituellement.
Dialogue: 0,0:10:00.92,0:10:02.92,Default,,0,0,0,,{\pos(962,1016)}Est-ce ainsi ?
Dialogue: 0,0:10:02.92,0:10:05.34,Default,,0,0,0,,{\pos(962,1016)}Pour qu'un salarié divertisse ses clients en jouant au golf...
Dialogue: 0,0:10:05.34,0:10:07.86,Default,,0,0,0,,{\pos(962,1016)}... c'est juste une chose normale à faire.
Dialogue: 0,0:10:07.86,0:10:09.86,Default,,0,0,0,,{\pos(962,1016)}Oui.
Dialogue: 0,0:10:22.66,0:10:24.32,Default,,0,0,0,,{\pos(962,1016)}C'est incroyable !
Dialogue: 0,0:10:38.22,0:10:39.92,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que c'est ?
Dialogue: 0,0:10:41.74,0:10:43.08,Default,,0,0,0,,{\pos(962,1016)}Ils courent.
Dialogue: 0,0:10:47.68,0:10:49.14,Default,,0,0,0,,{\pos(962,1016)}Poubelles.
Dialogue: 0,0:10:50.32,0:10:51.56,Default,,0,0,0,,{\pos(962,1016)}Boîte au lettres.
Dialogue: 0,0:10:54.60,0:10:56.00,Default,,0,0,0,,{\pos(962,1016)}Chauve originel.
Dialogue: 0,0:10:56.00,0:10:57.16,Default,,0,0,0,,{\pos(962,1016)}Pardon ?!
Dialogue: 0,0:11:02.84,0:11:04.62,Default,,0,0,0,,{\pos(962,1016)}Hé, ça pourrait être...
Dialogue: 0,0:11:05.46,0:11:06.68,Default,,0,0,0,,{\pos(962,1016)}... assez incroyable !
Dialogue: 0,0:11:07.28,0:11:09.92,Default,,0,0,0,,{\pos(962,1016)}Nathan !!!
Dialogue: 0,0:11:09.98,0:11:11.58,Default,,0,0,0,,{\pos(962,1016)}Ah ! C'est Jibanyan !
Dialogue: 0,0:11:17.18,0:11:18.10,Default,,0,0,0,,{\pos(962,1016)}Aïe, aïe , aïe...
Dialogue: 0,0:11:18.10,0:11:21.30,Default,,0,0,0,,{\pos(962,1016)}Mon corps est un peu plus lourd que d'habitude.
Dialogue: 0,0:11:22.44,0:11:25.42,Default,,0,0,0,,{\pos(962,1016)}On dirait que tu as trébuché là-dessus.
Dialogue: 0,0:11:25.42,0:11:29.08,Default,,0,0,0,,{\pos(962,1016)}Ne dites à personne que j'ai trébuché comme ça !
Dialogue: 0,0:11:29.20,0:11:31.58,Default,,0,0,0,,{\pos(962,1016)}Mais plus important : tu es Nathan, n'est-ce pas ?
Dialogue: 0,0:11:33.68,0:11:36.56,Default,,0,0,0,,{\pos(962,1016)}J'ai beaucoup changé. Mais...
Dialogue: 0,0:11:36.66,0:11:37.70,Default,,0,0,0,,{\pos(962,1016)}... je suis Nathan !
Dialogue: 0,0:11:37.70,0:11:41.10,Default,,0,0,0,,{\pos(962,1016)}Alors, restons-en là.
Dialogue: 0,0:11:41.28,0:11:43.88,Default,,0,0,0,,{\pos(962,1016)}On dirait que quelque chose s'est passé,
Dialogue: 0,0:11:43.88,0:11:47.12,Default,,0,0,0,,{\pos(962,1016)}tous les Yo-kai sont perturbés !
Dialogue: 0,0:11:47.18,0:11:48.52,Default,,0,0,0,,{\pos(962,1016)}Tous les Yo-kai sont...
Dialogue: 0,0:11:49.16,0:11:50.62,Default,,0,0,0,,{\pos(962,1016)}... perturbés ?
Dialogue: 0,0:11:52.12,0:11:55.62,Default,,0,0,0,,{\pos(962,1016)}En d’autres termes, les humains ne l’ont pas remarqué…
Dialogue: 0,0:11:55.62,0:11:59.08,Default,,0,0,0,,{\pos(962,1016)}Mais les Yo-kai sont tous aussi confus que moi ?
Dialogue: 0,0:11:59.08,0:12:00.38,Default,,0,0,0,,{\pos(962,1016)}Oui, nya !
Dialogue: 0,0:12:00.38,0:12:02.38,Default,,0,0,0,,{\pos(962,1016)}Je me demande pourquoi ?
Dialogue: 0,0:12:02.38,0:12:03.50,Default,,0,0,0,,{\pos(962,1016)}Ah-ha !
Dialogue: 0,0:12:03.50,0:12:06.38,Default,,0,0,0,,{\pos(962,1016)}Parce que Nathan est fortement impliqué avec les Yo-kai...
Dialogue: 0,0:12:06.38,0:12:09.72,Default,,0,0,0,,{\pos(962,1016)}...il est traité comme un Yo-kai !
Dialogue: 0,0:12:10.00,0:12:10.62,Default,,0,0,0,,{\pos(962,1016)}Hein ?
Dialogue: 0,0:12:10.62,0:12:12.62,Default,,0,0,0,,{\pos(962,1016)}"Traité comme un Yo-kai" ?
Dialogue: 0,0:12:14.14,0:12:17.32,Default,,0,0,0,,{\pos(962,1016)}Nous sommes un groupe Yo-kai !
Dialogue: 0,0:12:29.16,0:12:30.56,Default,,0,0,0,,{\pos(962,1016)}Nous n'avons pas le choix.
Dialogue: 0,0:12:32.12,0:12:32.98,Default,,0,0,0,,{\pos(962,1016)}Il faut absolument...
Dialogue: 0,0:12:34.06,0:12:35.36,Default,,0,0,0,,{\pos(962,1016)}... résoudre ce mystère !
Dialogue: 0,0:12:36.34,0:12:39.58,Default,,0,0,0,,{\pos(962,1016)}Au nom de mon grand-père !
Dialogue: 0,0:12:40.90,0:12:43.56,Default,,0,0,0,,{\pos(962,1016)}Cette angle ne fonctionne pas ici.
Dialogue: 0,0:12:43.56,0:12:44.78,Default,,0,0,0,,{\pos(962,1016)}Arrête ça.
Dialogue: 0,0:12:46.34,0:12:47.94,Default,,0,0,0,,{\pos(962,1016)}Tout d’abord, rassemblons quelques indices.
Dialogue: 0,0:12:47.94,0:12:50.16,Default,,0,0,0,,{\pos(962,1016)}Rendons visite à Katie, Matt et Balaise !
Dialogue: 0,0:12:50.16,0:12:53.24,Default,,0,0,0,,{\pos(962,1016)}Ça a l'air vraiment amusant, nya !
Dialogue: 0,0:12:53.24,0:12:56.24,Default,,0,0,0,,{\pos(962,1016)}Mission : Rencontrer Katie
Dialogue: 0,0:13:02.60,0:13:04.08,Default,,0,0,0,,{\pos(962,1016)}Est-ce que Katie est vraiment chez elle ?
Dialogue: 0,0:13:04.08,0:13:05.78,Default,,0,0,0,,{\pos(962,1016)}Attends, Nathan.
Dialogue: 0,0:13:05.90,0:13:09.78,Default,,0,0,0,,{\pos(962,1016)}En faisant ça, tu as l’air vraiment étrange !
Dialogue: 0,0:13:09.78,0:13:12.68,Default,,0,0,0,,{\pos(962,1016)}Nyaa ! C'est vraiment mauvais !
Dialogue: 0,0:13:13.04,0:13:14.92,Default,,0,0,0,,{\pos(962,1016)}Dans ce cas...
Dialogue: 0,0:13:14.92,0:13:16.92,Default,,0,0,0,,{\pos(962,1016)}... inventons juste une excuse...
Dialogue: 0,0:13:17.60,0:13:19.10,Default,,0,0,0,,{\pos(962,1016)}...et rencontrons-la directement !
Dialogue: 0,0:13:19.10,0:13:21.94,Default,,0,0,0,,{\pos(962,1016)}Ça veut dire que tu vas parler directement avec elle ?
Dialogue: 0,0:13:34.66,0:13:35.72,Default,,0,0,0,,{\pos(962,1016)}Aïe aïe...
Dialogue: 0,0:13:35.72,0:13:36.88,Default,,0,0,0,,{\pos(962,1016)}Nathan ?
Dialogue: 0,0:13:38.96,0:13:40.78,Default,,0,0,0,,{\pos(962,1016)}Est-ce que tu es Ka... Katie ?
Dialogue: 0,0:13:40.78,0:13:42.78,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que tu fais là, Nathan.
Dialogue: 0,0:13:43.02,0:13:44.36,Default,,0,0,0,,{\pos(962,1016)}Tu es...
Dialogue: 0,0:13:44.36,0:13:46.36,Default,,0,0,0,,{\pos(962,1016)}Katie, n'est-ce pas ?
Dialogue: 0,0:13:56.22,0:13:58.48,Default,,0,0,0,,{\pos(962,1016)}Je vais à l'école , qu'est ce qu'il y a ?
Dialogue: 0,0:13:58.78,0:13:59.60,Default,,0,0,0,,{\pos(962,1016)}À l'école ?
Dialogue: 0,0:14:00.34,0:14:02.62,Default,,0,0,0,,{\pos(962,1016)}Elle est plutôt incroyable.
Dialogue: 0,0:14:02.62,0:14:03.92,Default,,0,0,0,,{\pos(962,1016)}C’est sûr.
Dialogue: 0,0:14:04.66,0:14:06.76,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que tu marmonnes ?
Dialogue: 0,0:14:07.60,0:14:10.20,Default,,0,0,0,,{\pos(962,1016)}Pourquoi es-tu venu chez moi ?
Dialogue: 0,0:14:10.74,0:14:12.38,Default,,0,0,0,,{\pos(962,1016)}Euh...
Dialogue: 0,0:14:13.24,0:14:14.14,Default,,0,0,0,,{\pos(962,1016)}Oh c'est vrai...
Dialogue: 0,0:14:14.14,0:14:16.14,Default,,0,0,0,,{\pos(962,1016)}J'ai oublié mon carnet...
Dialogue: 0,0:14:16.14,0:14:18.14,Default,,0,0,0,,{\pos(962,1016)}...Je l'ai accidentellement laissé dans la classe.
Dialogue: 0,0:14:18.82,0:14:21.78,Default,,0,0,0,,{\pos(962,1016)}Hmm... C'est inhabituel venant de toi.
Dialogue: 0,0:14:21.78,0:14:24.10,Default,,0,0,0,,{\pos(962,1016)}Nan, ce n'est pas du tout ça !
Dialogue: 0,0:14:24.10,0:14:27.18,Default,,0,0,0,,{\pos(962,1016)}Je veux dire, n'importe qui pourrait être négligeant et puis...
Dialogue: 0,0:14:27.18,0:14:29.18,Default,,0,0,0,,{\pos(962,1016)}Euh... je suis fichu....
Dialogue: 0,0:14:29.18,0:14:31.40,Default,,0,0,0,,{\pos(962,1016)}Ah ah. C'était donc ça.
Dialogue: 0,0:14:32.36,0:14:33.44,Default,,0,0,0,,{\pos(962,1016)}Hein ?
Dialogue: 0,0:14:33.44,0:14:36.80,Default,,0,0,0,,{\pos(962,1016)}Mais comme tu le sais, nous ne sommes plus des enfants.
Dialogue: 0,0:14:36.80,0:14:38.80,Default,,0,0,0,,{\pos(962,1016)}Être trop franc entraînera des problèmes.
Dialogue: 0,0:14:50.92,0:14:52.36,Default,,0,0,0,,{\pos(962,1016)}Tu comprends, n'est-ce pas ?
Dialogue: 0,0:14:52.36,0:14:54.36,Default,,0,0,0,,{\pos(962,1016)}Si quelqu'un nous voit ici,
Dialogue: 0,0:14:54.36,0:14:57.22,Default,,0,0,0,,{\pos(962,1016)}... les gens commenceront à se faire des idées...
Dialogue: 0,0:14:57.22,0:14:59.76,Default,,0,0,0,,{\pos(962,1016)}Ce serait un problème. Alors ne traîne pas ici, d'accord ?
Dialogue: 0,0:15:00.98,0:15:02.78,Default,,0,0,0,,{\pos(962,1016)}Ouais... je suppose que c'est pas faux.
Dialogue: 0,0:15:05.90,0:15:10.04,Default,,0,0,0,,{\pos(962,1016)}Si tu as envie de discuter, il existe de bien meilleurs endroits, non ?
Dialogue: 0,0:15:10.68,0:15:11.26,Default,,0,0,0,,{\pos(962,1016)}Hein ?
Dialogue: 0,0:15:18.66,0:15:21.00,Default,,0,0,0,,{\pos(962,1016)}Bon, à bientôt alors.
Dialogue: 0,0:15:27.90,0:15:30.02,Default,,0,0,0,,{\pos(962,1016)}C'était vraiment Katie ?
Dialogue: 0,0:15:30.50,0:15:34.78,Default,,0,0,0,,{\pos(962,1016)}Peu importe, c’était une conversation très gênante et inhabituelle, de quoi être mal à l'aise !
Dialogue: 0,0:15:36.10,0:15:37.04,Default,,0,0,0,,{\pos(962,1016)}J’aime bien.
Dialogue: 0,0:15:37.12,0:15:37.72,Default,,0,0,0,,{\pos(962,1016)}Hein ?
Dialogue: 0,0:15:37.72,0:15:39.10,Default,,0,0,0,,{\pos(962,1016)}Ce monde...
Dialogue: 0,0:15:39.10,0:15:40.66,Default,,0,0,0,,{\pos(962,1016)}C'est plutôt cool !
Dialogue: 0,0:15:40.66,0:15:41.40,Default,,0,0,0,,{\pos(962,1016)}Quoi ?!
Dialogue: 0,0:15:41.40,0:15:44.40,Default,,0,0,0,,{\pos(962,1016)}Même les petits points de Katie sont mignons !
Dialogue: 0,0:15:45.48,0:15:47.70,Default,,0,0,0,,{\pos(962,1016)}Le monde des petits points est génial !
Dialogue: 0,0:15:47.70,0:15:48.88,Default,,0,0,0,,{\pos(962,1016)}Ouais ! Génial !
Dialogue: 0,0:15:48.88,0:15:52.60,Default,,0,0,0,,{\pos(962,1016)}Il y a un certain niveau de malaise dans le subconscient de cet enfant.
Dialogue: 0,0:15:52.68,0:15:56.42,Default,,0,0,0,,{\pos(962,1016)}Mission : Rencontrer Balaise et Matt
Dialogue: 0,0:15:57.44,0:15:58.60,Default,,0,0,0,,{\pos(962,1016)}Oh ! Ils sont là !
Dialogue: 0,0:15:58.60,0:15:59.18,Default,,0,0,0,,{\pos(962,1016)}Oh !
Dialogue: 0,0:15:59.28,0:16:00.78,Default,,0,0,0,,{\pos(962,1016)}Allez, viens là !
Dialogue: 0,0:16:01.64,0:16:04.22,Default,,0,0,0,,{\pos(962,1016)}Allez, allez, allez !
Dialogue: 0,0:16:04.22,0:16:06.22,Default,,0,0,0,,{\pos(962,1016)}Ça y est !
Dialogue: 0,0:16:06.22,0:16:08.22,Default,,0,0,0,,{\pos(962,1016)}Je l’ai ! Je l’ai ! Je l’ai !
Dialogue: 0,0:16:15.82,0:16:19.90,Default,,0,0,0,,{\pos(962,1016)}J'ai enfin la figurine rare de l'empereur Krill !
Dialogue: 0,0:16:20.50,0:16:22.76,Default,,0,0,0,,{\pos(962,1016)}C'est super ! Tant mieux pour toi, Balaise !
Dialogue: 0,0:16:22.82,0:16:23.90,Default,,0,0,0,,{\pos(962,1016)}Est-ce que ces deux-là...
Dialogue: 0,0:16:23.90,0:16:25.08,Default,,0,0,0,,{\pos(962,1016)}... Balaise et...
Dialogue: 0,0:16:25.08,0:16:26.12,Default,,0,0,0,,{\pos(962,1016)}... Matt ?
Dialogue: 0,0:16:26.22,0:16:28.18,Default,,0,0,0,,{\pos(962,1016)}On dirait.
Dialogue: 0,0:16:28.18,0:16:29.28,Default,,0,0,0,,{\pos(962,1016)}Balaise...
Dialogue: 0,0:16:29.28,0:16:31.42,Default,,0,0,0,,{\pos(962,1016)}... ressemble un peu à un homme d'âge moyen. Ou plutôt...
Dialogue: 0,0:16:33.10,0:16:34.18,Default,,0,0,0,,{\pos(962,1016)}...un Yo-kai ?
Dialogue: 0,0:16:37.34,0:16:39.68,Default,,0,0,0,,{\pos(962,1016)}Salut Matt. Bonne chance à toi aussi.
Dialogue: 0,0:16:41.54,0:16:42.88,Default,,0,0,0,,{\pos(962,1016)}Attends une seconde, Balaise !
Dialogue: 0,0:16:44.26,0:16:44.94,Default,,0,0,0,,{\pos(962,1016)}Je vais...
Dialogue: 0,0:16:46.78,0:16:48.06,Default,,0,0,0,,{\pos(962,1016)}Je te l'achète pour 1 euro 75 !
Dialogue: 0,0:16:49.18,0:16:50.08,Default,,0,0,0,,{\pos(962,1016)}Quoi ?
Dialogue: 0,0:16:50.40,0:16:52.32,Default,,0,0,0,,{\pos(962,1016)}Ce n'est pas marrant, Matt.
Dialogue: 0,0:16:52.32,0:16:55.04,Default,,0,0,0,,{\pos(962,1016)}Il doit coûter au moins 2 euros 90 !
Dialogue: 0,0:16:55.72,0:16:59.14,Default,,0,0,0,,{\pos(962,1016)}Eh bien, dans ce cas... puisque nous sommes amis...
Dialogue: 0,0:17:00.72,0:17:02.20,Default,,0,0,0,,{\pos(962,1016)}que dirais-tu de 2 euros ?
Dialogue: 0,0:17:04.00,0:17:05.78,Default,,0,0,0,,{\pos(962,1016)}2 euros 10 ?
Dialogue: 0,0:17:08.72,0:17:10.30,Default,,0,0,0,,{\pos(962,1016)}2 euros 20 ?
Dialogue: 0,0:17:12.18,0:17:13.14,Default,,0,0,0,,{\pos(962,1016)}40.
Dialogue: 0,0:17:16.06,0:17:16.78,Default,,0,0,0,,{\pos(962,1016)}2 euros 30 ?
Dialogue: 0,0:17:16.78,0:17:17.42,Default,,0,0,0,,{\pos(962,1016)}Non,
Dialogue: 0,0:17:17.42,0:17:18.42,Default,,0,0,0,,{\pos(962,1016)}40.
Dialogue: 0,0:17:21.60,0:17:23.42,Default,,0,0,0,,{\pos(962,1016)}Il est dur.
Dialogue: 0,0:17:24.66,0:17:27.22,Default,,0,0,0,,{\pos(962,1016)}C'était Balaise et Matt... n'est-ce pas ?
Dialogue: 0,0:17:29.52,0:17:30.94,Default,,0,0,0,,{\pos(962,1016)}Ce monde...
Dialogue: 0,0:17:30.94,0:17:32.94,Default,,0,0,0,,{\pos(962,1016)}...est tellement différent de ce que nous connaissons.
Dialogue: 0,0:17:33.34,0:17:37.50,Default,,0,0,0,,{\pos(962,1016)}Comparés à Katie, ce sont des personnages complètement différents !
Dialogue: 0,0:17:37.50,0:17:41.32,Default,,0,0,0,,{\pos(962,1016)}Mais les Next HarMIAOUny sont mignonnes même dans ce monde, nya !
Dialogue: 0,0:17:41.32,0:17:42.38,Default,,0,0,0,,{\pos(962,1016)}Whis !
Dialogue: 0,0:17:43.86,0:17:47.32,Default,,0,0,0,,{\pos(962,1016)}Matt va bien mais Balaise c'est trop.
Dialogue: 0,0:17:48.32,0:17:49.14,Default,,0,0,0,,{\pos(962,1016)}Nya !
Dialogue: 0,0:17:49.60,0:17:51.24,Default,,0,0,0,,{\pos(962,1016)}Ce ne serait pas...
Dialogue: 0,0:17:51.24,0:17:53.24,Default,,0,0,0,,{\pos(962,1016)}... Amélie ?
Dialogue: 0,0:17:55.90,0:17:58.10,Default,,0,0,0,,{\pos(962,1016)}Amélie !
Dialogue: 0,0:17:58.20,0:17:58.96,Default,,0,0,0,,{\pos(962,1016)}Jibanyan !
Dialogue: 0,0:18:10.68,0:18:12.00,Default,,0,0,0,,{\pos(962,1016)}De toutes manières...
Dialogue: 0,0:18:12.00,0:18:14.00,Default,,0,0,0,,{\pos(962,1016)}Ça doit être l'œuvre d'un Yo-kai.
Dialogue: 0,0:18:14.40,0:18:16.34,Default,,0,0,0,,{\pos(962,1016)}Je ne vois aucune autre explication.
Dialogue: 0,0:18:16.60,0:18:17.48,Default,,0,0,0,,{\pos(962,1016)}Quoi ?
Dialogue: 0,0:18:17.48,0:18:19.48,Default,,0,0,0,,{\pos(962,1016)}Attends une seconde, Nathan.
Dialogue: 0,0:18:19.48,0:18:24.00,Default,,0,0,0,,{\pos(962,1016)}Je n'ai jamais entendu parler d'un Yo-kai pareil !
Dialogue: 0,0:18:24.00,0:18:25.12,Default,,0,0,0,,{\pos(962,1016)}Le voilà !
Dialogue: 0,0:18:25.12,0:18:26.78,Default,,0,0,0,,{\pos(962,1016)}Ça existe !
Dialogue: 0,0:18:37.00,0:18:38.54,Default,,0,0,0,,{\pos(962,1016)}Quelle est cette chose ?
Dialogue: 0,0:18:39.96,0:18:41.36,Default,,0,0,0,,{\pos(962,1016)}Koala... ?
Dialogue: 0,0:18:42.64,0:18:43.72,Default,,0,0,0,,{\pos(962,1016)}Un animal en peluche ?
Dialogue: 0,0:18:45.90,0:18:49.78,Default,,0,0,0,,{\pos(962,1016)}Nathan, tu ne penses pas qu'il essaie de nous charmer ?
Dialogue: 0,0:18:49.78,0:18:51.44,Default,,0,0,0,,{\pos(962,1016)}Je sais !
Dialogue: 0,0:18:51.48,0:18:55.12,Default,,0,0,0,,{\pos(962,1016)}C'est un terrible Yo-kai qui essaie d'être mignon tout en cachant le fait que...
Dialogue: 0,0:18:55.12,0:18:57.12,Default,,0,0,0,,{\pos(962,1016)}...c'est lui qui a causé tout ça...
Dialogue: 0,0:18:57.12,0:18:59.12,Default,,0,0,0,,{\pos(962,1016)}Hé ! Fais que tout redevienne comme avant !
Dialogue: 0,0:19:05.68,0:19:10.42,Default,,0,0,0,,{\pos(962,1016)}Pourquoi nous fait-il faire ces poses idiotes ?
Dialogue: 0,0:19:10.46,0:19:12.92,Default,,0,0,0,,{\pos(962,1016)}C'est inutile... !
Dialogue: 0,0:19:15.36,0:19:16.60,Default,,0,0,0,,{\pos(962,1016)}Bien...
Dialogue: 0,0:19:17.06,0:19:19.06,Default,,0,0,0,,{\pos(962,1016)}Montre nous ta véritable apparence, Yo-kai maléfique !
Dialogue: 0,0:19:21.64,0:19:24.68,Default,,0,0,0,,{\pos(962,1016)}Je pense qu'il essaie de te faire comprendre que tu t'es trompé.
Dialogue: 0,0:19:25.62,0:19:27.44,Default,,0,0,0,,{\pos(962,1016)}Quel est ton nom ?
Dialogue: 0,0:19:29.78,0:19:32.40,Default,,0,0,0,,{\pos(962,1016)}Il ne semble pas vraiment le savoir.
Dialogue: 0,0:19:38.46,0:19:40.26,Default,,0,0,0,,{\pos(962,1016)}Appelons-le simplement, Koalanyan.
Dialogue: 0,0:19:43.76,0:19:46.02,Default,,0,0,0,,{\pos(962,1016)}Koalanyan !
Dialogue: 0,0:19:46.02,0:19:47.58,Default,,0,0,0,,{\pos(962,1016)}Mon Dieu !
Dialogue: 0,0:19:47.58,0:19:50.64,Default,,0,0,0,,{\pos(962,1016)}Comme on s'y attendait de la part de Nathan, irrespectueux
Dialogue: 0,0:19:50.64,0:19:51.80,Default,,0,0,0,,{\pos(962,1016)}et avec un terrible non-sens.
Dialogue: 0,0:19:51.80,0:19:53.72,Default,,0,0,0,,{\pos(962,1016)}C'est pourtant facile à comprendre.
Dialogue: 0,0:19:53.72,0:19:55.64,Default,,0,0,0,,{\pos(962,1016)}Des gens comme toi...
Dialogue: 0,0:19:55.64,0:19:57.92,Default,,0,0,0,,{\pos(962,1016)}Au lieu de donner à un chien un nom normal...
Dialogue: 0,0:19:57.96,0:19:59.92,Default,,0,0,0,,{\pos(962,1016)}...comme "Rex" ou "Médor", vous l'appelleriez juste "Chien".
Dialogue: 0,0:20:01.02,0:20:02.10,Default,,0,0,0,,{\pos(962,1016)}Koalanyan !
Dialogue: 0,0:20:02.10,0:20:04.76,Default,,0,0,0,,{\pos(962,1016)}Tu peux essayer de rester muet autant de temps que tu veux, mais...
Dialogue: 0,0:20:04.76,0:20:06.50,Default,,0,0,0,,{\pos(962,1016)}... pas si Toutouïe est là !
Dialogue: 0,0:20:08.50,0:20:12.86,Default,,0,0,0,,{\pos(962,1016)}Allez mon ami, à toi de jouer...
Dialogue: 0,0:20:12.86,0:20:14.86,Default,,0,0,0,,{\pos(962,1016)}... Toutouïe !
Dialogue: 0,0:20:14.86,0:20:16.86,Default,,0,0,0,,{\pos(962,1016)}Médaille Yo-kai...
Dialogue: 0,0:20:17.74,0:20:19.26,Default,,0,0,0,,{\pos(962,1016)}... activation !
Dialogue: 0,0:20:20.94,0:20:24.34,Default,,0,0,0,,{\pos(962,1016)}C’est l'heure des Mystérieux !
Dialogue: 0,0:20:24.34,0:20:27.64,Default,,0,0,0,,{\pos(962,1016)}Roulette de Rêve !
Dialogue: 0,0:20:28.00,0:20:30.18,Default,,0,0,0,,{\pos(962,1016)}Mystérieux... Mystérieux
Dialogue: 0,0:20:30.18,0:20:32.18,Default,,0,0,0,,{\pos(962,1016)}Que va-t-il se passer ?
Dialogue: 0,0:20:32.18,0:20:35.36,Default,,0,0,0,,{\pos(962,1016)}Mystérieux !
Dialogue: 0,0:20:36.64,0:20:39.26,Default,,0,0,0,,{\pos(962,1016)}Félicitations !
Dialogue: 0,0:20:43.64,0:20:45.06,Default,,0,0,0,,{\pos(962,1016)}Toutouïe !
Dialogue: 0,0:20:51.86,0:20:55.08,Default,,0,0,0,,{\pos(962,1016)}OK, Toutouïe ! Demande à Koalanyan de nous révéler tous ses secrets !
Dialogue: 0,0:20:57.98,0:20:59.34,Default,,0,0,0,,{\pos(962,1016)}Alors Koalanyan ?
Dialogue: 0,0:20:59.34,0:21:01.80,Default,,0,0,0,,{\pos(962,1016)}Avoue tout ce que tu sais !
Dialogue: 0,0:21:16.26,0:21:18.88,Default,,0,0,0,,{\pos(962,1016)}Cela ressemble à...
Dialogue: 0,0:21:19.10,0:21:20.44,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que tu dis ?
Dialogue: 0,0:21:20.44,0:21:23.46,Default,,0,0,0,,{\pos(962,1016)}Je n'en ai pas la moindre idée...
Dialogue: 0,0:21:29.42,0:21:33.80,Default,,0,0,0,,{\pos(962,1016)}Toutouïe ne peut pas lui faire dire des choses compréhensibles.
Dialogue: 0,0:21:35.86,0:21:38.54,Default,,0,0,0,,{\pos(962,1016)}Qu'essayes-tu de nous dire ?
Dialogue: 0,0:21:42.76,0:21:44.64,Default,,0,0,0,,{\pos(962,1016)}Qu'est ce que tu es têtu...
Dialogue: 0,0:21:46.76,0:21:47.60,Default,,0,0,0,,{\pos(962,1016)}Hein ?
Dialogue: 0,0:21:55.86,0:21:57.22,Default,,0,0,0,,{\pos(962,1016)}Nous sommes de retour !
Dialogue: 0,0:21:57.30,0:21:59.38,Default,,0,0,0,,{\pos(962,1016)}C'est quoi ce rebondissement ?!
Dialogue: 0,0:22:00.08,0:22:02.48,Default,,0,0,0,,{\pos(962,1016)}Comment sommes-nous revenus dans notre monde ?
Dialogue: 0,0:22:06.96,0:22:09.42,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que tu essayes de nous dire ?
Dialogue: 0,0:22:11.90,0:22:13.82,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que c'était à l'instant ?
Dialogue: 0,0:22:13.82,0:22:17.10,Default,,0,0,0,,{\pos(962,1016)}Eh bien... Quoi qu'il en soit, c'est bon d'être de retour.
Dialogue: 0,0:22:17.10,0:22:19.90,Default,,0,0,0,,{\pos(962,1016)}C'est encore trop tôt pour le dire !
Dialogue: 0,0:22:22.30,0:22:23.50,Default,,0,0,0,,{\pos(962,1016)}Hovernyan !
Dialogue: 0,0:22:24.48,0:22:28.86,Default,,0,0,0,,{\pos(962,1016)}Ce phénomène était définitivement l'œuvre d'un Yo-kai !
Dialogue: 0,0:22:29.10,0:22:31.72,Default,,0,0,0,,{\pos(962,1016)}Hein ? Que viens-tu de dire ?
Dialogue: 0,0:22:33.42,0:22:35.66,Default,,0,0,0,,{\pos(962,1016)}J'essaie de dire que ça va se reproduire !
Dialogue: 0,0:22:36.10,0:22:39.24,Default,,0,0,0,,{\pos(962,1016)}Pourquoi ce chat volant est-il ici de toutes façons ?
Dialogue: 0,0:22:40.38,0:22:42.66,Default,,0,0,0,,{\pos(962,1016)}Par le biais de telles ou telles choses...
Dialogue: 0,0:22:42.68,0:22:43.96,Default,,0,0,0,,{\pos(962,1016)}J'ai perçu le phénomène...
Dialogue: 0,0:22:43.96,0:22:46.48,Default,,0,0,0,,{\pos(962,1016)}... et je savais que tout dépend de toi, Nathan !
Dialogue: 0,0:22:46.82,0:22:49.76,Default,,0,0,0,,{\pos(962,1016)}Hein... C'est une explication assez incomplète.
Dialogue: 0,0:22:50.60,0:22:52.84,Default,,0,0,0,,{\pos(962,1016)}Alors, quel Yo-kai est responsable de cela ?
Dialogue: 0,0:22:52.84,0:22:55.96,Default,,0,0,0,,{\pos(962,1016)}C'est quelque chose d'énorme, avec une nature mystérieuse.
Dialogue: 0,0:22:55.96,0:22:58.42,Default,,0,0,0,,{\pos(962,1016)}Et c'est quelque chose d'assez méchant, comme ça !
Dialogue: 0,0:22:58.42,0:23:00.42,Default,,0,0,0,,{\pos(962,1016)}C'est trop vague...
Dialogue: 0,0:23:00.42,0:23:02.24,Default,,0,0,0,,{\pos(962,1016)}Et ça m'a englouti !
Dialogue: 0,0:23:02.28,0:23:03.46,Default,,0,0,0,,{\pos(962,1016)}De toutes façons !
Dialogue: 0,0:23:03.46,0:23:05.46,Default,,0,0,0,,{\pos(962,1016)}La raison pour laquelle le monde a changé...
Dialogue: 0,0:23:05.46,0:23:08.08,Default,,0,0,0,,{\pos(962,1016)}... est quelque chose que nous devons découvrir immédiatement !
Dialogue: 0,0:23:08.14,0:23:10.50,Default,,0,0,0,,{\pos(962,1016)}Mais nous n'avons aucun indice.
Dialogue: 0,0:23:10.50,0:23:12.38,Default,,0,0,0,,{\pos(962,1016)}Nous demanderons simplement à quelqu'un qui sait.
Dialogue: 0,0:23:12.38,0:23:14.74,Default,,0,0,0,,{\pos(962,1016)}Qui saurait ça ?
Dialogue: 0,0:23:16.74,0:23:18.80,Default,,0,0,0,,{\pos(962,1016)}Certainement le Seigneur Enma !
Dialogue: 0,0:23:18.80,0:23:21.70,Default,,0,0,0,,{\pos(962,1016)}Quoi ?! Le Seigneur Enma ?!
Dialogue: 0,0:23:22.42,0:23:25.40,Default,,0,0,0,,{\pos(962,1016)}Eh bien... Il semble certain qu'il saurait...
Dialogue: 0,0:23:25.80,0:23:28.10,Default,,0,0,0,,{\pos(962,1016)}Nous ne pouvons le rencontrer que si nous sommes dans le Yo-kai World...
Dialogue: 0,0:23:28.10,0:23:30.10,Default,,0,0,0,,{\pos(962,1016)}Alors laissez-moi faire !
Dialogue: 0,0:23:30.10,0:23:31.88,Default,,0,0,0,,{\pos(962,1016)}J'y vais !
Dialogue: 0,0:23:34.86,0:23:36.20,Default,,0,0,0,,{\pos(962,1016)}Et c'est reparti.
Dialogue: 0,0:23:36.20,0:23:37.20,Default,,0,0,0,,{\pos(962,1016)}Ouais...
Dialogue: 0,0:23:38.42,0:23:39.20,Default,,0,0,0,,{\pos(962,1016)}Qu'est ce que c'est ?
Dialogue: 0,0:23:48.02,0:23:49.86,Default,,0,0,0,,{\pos(962,1016)}On a un problème !
Dialogue: 0,0:23:49.86,0:23:52.50,Default,,0,0,0,,{\pos(962,1016)}Que s'est-il passé à l'instant ?!
Dialogue: 0,0:23:54.02,0:23:56.26,Default,,0,0,0,,{\pos(962,1016)}Le maître Yo-kai, Nathan devrait le savoir, n'est-ce pas ?
Dialogue: 0,0:23:56.38,0:23:59.74,Default,,0,0,0,,{\pos(962,1016)}T-Tu veux parler du monde des petits points d’avant ?!
Dialogue: 0,0:23:59.74,0:24:01.00,Default,,0,0,0,,{\pos(962,1016)}Même moi, non...
Dialogue: 0,0:24:01.86,0:24:03.14,Default,,0,0,0,,{\pos(962,1016)}Je ne le sais pas.
Dialogue: 0,0:24:03.14,0:24:05.14,Default,,0,0,0,,{\pos(962,1016)}Quelque chose est arrivé ?
Dialogue: 0,0:24:06.14,0:24:07.80,Default,,0,0,0,,{\pos(962,1016)}Il y a un gros problème... !
Dialogue: 0,0:24:07.80,0:24:11.00,Default,,0,0,0,,{\pos(962,1016)}Si cela se reproduit, il va y avoir de gros problèmes !
Dialogue: 0,0:24:11.72,0:24:14.38,Default,,0,0,0,,{\pos(962,1016)}Après que le monde soit devenu vraiment bizarre…
Dialogue: 0,0:24:14.38,0:24:16.72,Default,,0,0,0,,{\pos(962,1016)}Ariane... Ou plutôt la fille qui ressemble à Ariane...
Dialogue: 0,0:24:16.72,0:24:20.98,Default,,0,0,0,,{\pos(962,1016)}...a soudainement commencé à mélanger une potion super étrange !
Dialogue: 0,0:24:26.74,0:24:32.18,Default,,0,0,0,,{\pos(962,1016)}Elle a probablement ajouté des matériaux dangereux pour essayer d'améliorer ses performances...
Dialogue: 0,0:24:32.28,0:24:33.48,Default,,0,0,0,,{\pos(962,1016)}Matières dangereuses... ?
Dialogue: 0,0:24:33.48,0:24:36.88,Default,,0,0,0,,{\pos(962,1016)}Comme des armes biologiques ou quelque chose comme ça... !
Dialogue: 0,0:24:36.88,0:24:40.34,Default,,0,0,0,,{\pos(962,1016)}En gros, elle essaie de faire quelque chose de terriblement dangereux !
Dialogue: 0,0:24:40.88,0:24:43.98,Default,,0,0,0,,{\pos(962,1016)}Il n’y a donc pas que l’apparence des gens qui change…
Dialogue: 0,0:24:43.98,0:24:47.04,Default,,0,0,0,,{\pos(962,1016)}... les personnalités sont exagérées dans le monde des petits points.
Dialogue: 0,0:24:47.14,0:24:48.64,Default,,0,0,0,,{\pos(962,1016)}Bien sûr !
Dialogue: 0,0:24:48.64,0:24:51.70,Default,,0,0,0,,{\pos(962,1016)}Pas étonnant que quelqu'un avec une personnalité aussi simple...
Dialogue: 0,0:24:51.70,0:24:54.42,Default,,0,0,0,,{\pos(962,1016)}... n'aurait pas grand-chose à exagérer instinctivement.
Dialogue: 0,0:24:59.82,0:25:01.74,Default,,0,0,0,,{\pos(962,1016)}Ouah ! Qu'est-ce que c'est ?
Dialogue: 0,0:25:01.74,0:25:04.48,Default,,0,0,0,,{\pos(962,1016)}Ils n'ont pas montré ça à la télévision ?
Dialogue: 0,0:25:04.48,0:25:06.48,Default,,0,0,0,,{\pos(962,1016)}Ce vaisseau spatial extraterrestre... !
Dialogue: 0,0:25:06.48,0:25:10.42,Default,,0,0,0,,{\pos(962,1016)}Mais n'a-t-il pas l'air trop mou et caoutchouteux pour en être un ?!
Dialogue: 0,0:25:10.42,0:25:13.58,Default,,0,0,0,,{\pos(962,1016)}Peut-être que ces types d'extraterrestres fabriquent leurs vaisseaux spatiaux...
Dialogue: 0,0:25:13.62,0:25:16.46,Default,,0,0,0,,{\pos(962,1016)}...à partir de métaux spatiaux mous et caoutchouteux ?!
Dialogue: 0,0:25:16.46,0:25:18.60,Default,,0,0,0,,{\pos(962,1016)}Mais celle-ci ressemble à une baleine !
Dialogue: 0,0:25:18.60,0:25:20.60,Default,,0,0,0,,{\pos(962,1016)}Ce n’est pas possible !
Dialogue: 0,0:25:20.60,0:25:23.86,Default,,0,0,0,,{\pos(962,1016)}Si c'est une baleine, elle devrait crier « Baunnn » ou quelque chose comme ça !
Dialogue: 0,0:25:25.82,0:25:27.22,Default,,0,0,0,,{\pos(962,1016)}C'est ce qu'elle est en train de crier !
Dialogue: 0,0:25:27.22,0:25:28.96,Default,,0,0,0,,{\pos(962,1016)}Baunnn !!!
Dialogue: 0,0:25:29.06,0:25:30.54,Default,,0,0,0,,{\pos(962,1016)}Je comprends maintenant !
Dialogue: 0,0:25:30.54,0:25:32.54,Default,,0,0,0,,{\pos(962,1016)}Si ce que je pense est correct...
Dialogue: 0,0:25:32.78,0:25:35.54,Default,,0,0,0,,{\pos(962,1016)}C'est ce Yo-kai qui est responsable de tout ça !
Dialogue: 0,0:25:36.18,0:25:40.08,Default,,0,0,0,,{\pos(962,1016)}Eh bien, n'importe qui serait capable de comprendre cela à ce stade, Nathan...
Dialogue: 0,0:25:56.90,0:25:59.52,Default,,0,0,0,,{\pos(962,1016)}Nous sommes à nouveau dans ce monde ?
Dialogue: 0,0:26:04.60,0:26:09.72,Default,,0,0,0,,{\pos(962,1016)}Oh non ! Elle va probablement finir de préparer cette potion maintenant !
Dialogue: 0,0:26:10.16,0:26:12.18,Default,,0,0,0,,{\pos(962,1016)}Bye bye !
Dialogue: 0,0:26:16.94,0:26:18.72,Default,,0,0,0,,{\pos(962,1016)}Quel bruit...
Dialogue: 0,0:26:27.28,0:26:28.28,Default,,0,0,0,,{\pos(962,1016)}Hein ?
Dialogue: 0,0:26:28.28,0:26:29.44,Default,,0,0,0,,{\pos(962,1016)}La baleine est partie.
Dialogue: 0,0:26:30.64,0:26:32.34,Default,,0,0,0,,{\pos(962,1016)}Elle a s'est volatilisée !
Dialogue: 0,0:26:32.36,0:26:33.16,Default,,0,0,0,,{\pos(962,1016)}Amélie...
Dialogue: 0,0:26:33.74,0:26:35.24,Default,,0,0,0,,{\pos(962,1016)}Amélie...
Dialogue: 0,0:26:36.58,0:26:38.30,Default,,0,0,0,,{\pos(962,1016)}Amélie... !
Dialogue: 0,0:26:40.08,0:26:40.90,Default,,0,0,0,,{\pos(962,1016)}AMÉLIE... !
Dialogue: 0,0:26:40.90,0:26:42.16,Default,,0,0,0,,{\pos(962,1016)}Jibanyan ?
Dialogue: 0,0:26:42.28,0:26:43.92,Default,,0,0,0,,{\pos(962,1016)}Que se passe-t-il ?
Dialogue: 0,0:26:43.92,0:26:47.26,Default,,0,0,0,,{\pos(962,1016)}Ce n'est pas la Amélie que je connais !
Dialogue: 0,0:26:55.22,0:26:59.22,Default,,0,0,0,,{\pos(962,1016)}Amélie adore les jolis vêtements, comme toujours !
Dialogue: 0,0:26:59.34,0:27:00.84,Default,,0,0,0,,{\pos(962,1016)}Et c'est parce que...
Dialogue: 0,0:27:00.84,0:27:03.54,Default,,0,0,0,,{\pos(962,1016)}Elle rêve de devenir créatrice de vêtements !
Dialogue: 0,0:27:05.94,0:27:07.30,Default,,0,0,0,,{\pos(962,1016)}Maman !
Dialogue: 0,0:27:07.30,0:27:08.88,Default,,0,0,0,,{\pos(962,1016)}Jetons ça.
Dialogue: 0,0:27:11.80,0:27:13.30,Default,,0,0,0,,{\pos(962,1016)}Quoi ? Pourquoi ?
Dialogue: 0,0:27:13.30,0:27:14.76,Default,,0,0,0,,{\pos(962,1016)}Garde-les un moment.
Dialogue: 0,0:27:14.76,0:27:15.92,Default,,0,0,0,,{\pos(962,1016)}Non... je m'en fiche...
Dialogue: 0,0:27:15.92,0:27:17.92,Default,,0,0,0,,{\pos(962,1016)}Le design ne m'intéresse plus.
Dialogue: 0,0:27:18.26,0:27:20.18,Default,,0,0,0,,{\pos(962,1016)}Hein ? Tu en es sûre ?
Dialogue: 0,0:27:20.50,0:27:21.60,Default,,0,0,0,,{\pos(962,1016)}Oui.
Dialogue: 0,0:27:24.26,0:27:26.28,Default,,0,0,0,,{\pos(962,1016)}Des chiens mignons ! Des chiens intéressants !
Dialogue: 0,0:27:26.28,0:27:29.20,Default,,0,0,0,,{\pos(962,1016)}Des chiens populaires dans tout le pays !
Dialogue: 0,0:27:29.20,0:27:30.68,Default,,0,0,0,,{\pos(962,1016)}Diffusons uniquement des chiens !
Dialogue: 0,0:27:30.68,0:27:32.68,Default,,0,0,0,,{\pos(962,1016)}Ouaf ouaf magnifique !
Dialogue: 0,0:27:32.68,0:27:35.50,Default,,0,0,0,,{\pos(962,1016)}Amélie n'est pas intéressée par ça, n'est-ce pas ?
Dialogue: 0,0:27:35.50,0:27:37.96,Default,,0,0,0,,{\pos(962,1016)}Elle aime les chats, à 100% !
Dialogue: 0,0:27:37.96,0:27:38.92,Default,,0,0,0,,{\pos(962,1016)}Ouah.
Dialogue: 0,0:27:39.48,0:27:41.10,Default,,0,0,0,,{\pos(962,1016)}Tant de races différentes !
Dialogue: 0,0:27:43.26,0:27:44.74,Default,,0,0,0,,{\pos(962,1016)}Viens ici, Brinminet !
Dialogue: 0,0:27:45.08,0:27:46.86,Default,,0,0,0,,{\pos(962,1016)}Ooohh, Brunminet !
Dialogue: 0,0:27:48.82,0:27:50.44,Default,,0,0,0,,{\pos(962,1016)}Bon garçon ! Bien bien !
Dialogue: 0,0:27:50.44,0:27:51.50,Default,,0,0,0,,{\pos(962,1016)}Si mignon !
Dialogue: 0,0:27:52.38,0:27:53.46,Default,,0,0,0,,{\pos(962,1016)}Bon garçon ! Bon garçon !
Dialogue: 0,0:28:01.08,0:28:03.96,Default,,0,0,0,,{\pos(962,1016)}Pour qu'Amélie soit comme ça...
Dialogue: 0,0:28:03.96,0:28:06.86,Default,,0,0,0,,{\pos(962,1016)}... ce monde n'est pas bon...
Dialogue: 0,0:28:10.22,0:28:12.26,Default,,0,0,0,,{\pos(962,1016)}Hein ?! T'es qui, nya ?
Dialogue: 0,0:28:12.86,0:28:13.88,Default,,0,0,0,,{\pos(962,1016)}C'est Koalanyan.
Dialogue: 0,0:28:13.88,0:28:15.88,Default,,0,0,0,,{\pos(962,1016)}Mais c'est un nom pas fou.
Dialogue: 0,0:28:35.42,0:28:36.68,Default,,0,0,0,,{\pos(962,1016)}Pas encore !
Dialogue: 0,0:28:41.06,0:28:44.30,Default,,0,0,0,,{\pos(962,1016)}C'est juste un va-et-vient maintenant...
Dialogue: 0,0:28:44.30,0:28:45.50,Default,,0,0,0,,{\pos(962,1016)}Hein ?
Dialogue: 0,0:28:45.50,0:28:46.56,Default,,0,0,0,,{\pos(962,1016)}Est-ce que ça pourrait être... ?
Dialogue: 0,0:28:57.70,0:28:58.70,Default,,0,0,0,,{\pos(962,1016)}Bien sûr !
Dialogue: 0,0:28:59.90,0:29:02.84,Default,,0,0,0,,{\pos(962,1016)}Le nez de Koalanyan est l'interrupteur pour changer de monde.
Dialogue: 0,0:29:02.84,0:29:04.50,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que c'est ?
Dialogue: 0,0:29:04.50,0:29:07.34,Default,,0,0,0,,{\pos(962,1016)}Si tel est le cas, permets-moi de...
Dialogue: 0,0:29:07.34,0:29:08.46,Default,,0,0,0,,{\pos(962,1016)}Hein ?
Dialogue: 0,0:29:12.06,0:29:13.38,Default,,0,0,0,,{\pos(962,1016)}Attends !
Dialogue: 0,0:29:13.38,0:29:14.72,Default,,0,0,0,,{\pos(962,1016)}Viens ici !
Dialogue: 0,0:29:14.80,0:29:16.10,Default,,0,0,0,,{\pos(962,1016)}Arrête-toi là !
Dialogue: 0,0:29:16.52,0:29:18.12,Default,,0,0,0,,{\pos(962,1016)}J'ai dit stop !
Dialogue: 0,0:29:18.12,0:29:19.86,Default,,0,0,0,,{\pos(962,1016)}Viens ici !
Dialogue: 0,0:29:20.62,0:29:22.08,Default,,0,0,0,,{\pos(962,1016)}Pourquoi toi... !
Dialogue: 0,0:29:22.82,0:29:26.02,Default,,0,0,0,,{\pos(962,1016)}Comment on fait ? Comment on fait ? Comment on fait ?
Dialogue: 0,0:29:26.02,0:29:27.16,Default,,0,0,0,,{\pos(962,1016)}Je t'ai eu !
Dialogue: 0,0:29:38.78,0:29:39.96,Default,,0,0,0,,{\pos(962,1016)}Euh... quoi ?
Dialogue: 0,0:29:39.96,0:29:42.22,Default,,0,0,0,,{\pos(962,1016)}Quelle était cette pose ?!
Dialogue: 0,0:29:42.22,0:29:43.70,Default,,0,0,0,,{\pos(962,1016)}Bien sûr !
Dialogue: 0,0:29:43.70,0:29:45.88,Default,,0,0,0,,{\pos(962,1016)}Quand tu tires les oreilles...
Dialogue: 0,0:29:54.90,0:29:56.68,Default,,0,0,0,,{\pos(962,1016)}... ça arrive !
Dialogue: 0,0:29:56.68,0:29:58.26,Default,,0,0,0,,{\pos(962,1016)}C'est tout ce que tu sais ?
Dialogue: 0,0:29:58.26,0:30:00.04,Default,,0,0,0,,{\pos(962,1016)}C'est le nez !
Dialogue: 0,0:30:08.88,0:30:09.98,Default,,0,0,0,,{\pos(962,1016)}Tu vois ?
Dialogue: 0,0:30:09.98,0:30:11.40,Default,,0,0,0,,{\pos(962,1016)}C'est vrai !
Dialogue: 0,0:30:11.40,0:30:15.58,Default,,0,0,0,,{\pos(962,1016)}Avec un tel pouvoir, tu sais ce que ça veut dire... ?
Dialogue: 0,0:30:16.16,0:30:17.16,Default,,0,0,0,,{\pos(962,1016)}Oui !
Dialogue: 0,0:30:17.16,0:30:18.66,Default,,0,0,0,,{\pos(962,1016)}Voyons ce que ça peut faire !
Dialogue: 0,0:30:30.38,0:30:31.92,Default,,0,0,0,,{\pos(962,1016)}Désolé pour l'attente !
Dialogue: 0,0:30:31.92,0:30:32.86,Default,,0,0,0,,{\pos(962,1016)}Merci.
Dialogue: 0,0:30:33.18,0:30:34.16,Default,,0,0,0,,{\pos(962,1016)}Merci pour la nourriture.
Dialogue: 0,0:30:45.36,0:30:46.56,Default,,0,0,0,,{\pos(962,1016)}Hé.
Dialogue: 0,0:30:46.56,0:30:47.58,Default,,0,0,0,,{\pos(962,1016)}Les gars !
Dialogue: 0,0:30:49.28,0:30:50.06,Default,,0,0,0,,{\pos(962,1016)}Tu sais...
Dialogue: 0,0:30:50.12,0:30:53.04,Default,,0,0,0,,{\pos(962,1016)}C'est impoli de regarder les gens comme ça.
Dialogue: 0,0:30:55.10,0:30:55.64,Default,,0,0,0,,{\pos(962,1016)}OUAF !
Dialogue: 0,0:30:57.16,0:30:57.66,Default,,0,0,0,,{\pos(962,1016)}Bon sang.
Dialogue: 0,0:30:58.90,0:31:00.40,Default,,0,0,0,,{\pos(962,1016)}C'était choquant.
Dialogue: 0,0:31:08.86,0:31:11.62,Default,,0,0,0,,{\pos(962,1016)}Rencontrer Corniot comme ça...
Dialogue: 0,0:31:11.70,0:31:13.06,Default,,0,0,0,,{\pos(962,1016)}C'est tellement effrayant...
Dialogue: 0,0:31:14.00,0:31:15.18,Default,,0,0,0,,{\pos(962,1016)}N'est-ce pas ?
Dialogue: 0,0:31:15.52,0:31:16.80,Default,,0,0,0,,{\pos(962,1016)}Ouais.
Dialogue: 0,0:31:26.96,0:31:28.06,Default,,0,0,0,,{\pos(962,1016)}Quoi de neuf ?
Dialogue: 0,0:31:28.06,0:31:31.16,Default,,0,0,0,,{\pos(962,1016)}J'ai hâte de faire quelque chose ici.
Dialogue: 0,0:31:31.16,0:31:33.68,Default,,0,0,0,,{\pos(962,1016)}Je ny'ai pas combattu de camion depuis un moment.
Dialogue: 0,0:31:34.04,0:31:36.58,Default,,0,0,0,,{\pos(962,1016)}J'ai envie de faire ça maintenant !
Dialogue: 0,0:31:37.60,0:31:38.46,Default,,0,0,0,,{\pos(962,1016)}Il y en a un qui s’approche !
Dialogue: 0,0:31:39.40,0:31:40.42,Default,,0,0,0,,{\pos(962,1016)}C'est l’heure, nya !
Dialogue: 0,0:31:45.38,0:31:47.18,Default,,0,0,0,,{\pos(962,1016)}L'œil du tigre...
Dialogue: 0,0:31:58.88,0:32:01.00,Default,,0,0,0,,{\pos(962,1016)}J’aurais pu mourir, nya !
Dialogue: 0,0:32:22.72,0:32:25.12,Default,,0,0,0,,{\pos(962,1016)}As-tu... peur de l'eau ?
Dialogue: 0,0:32:29.30,0:32:30.74,Default,,0,0,0,,{\pos(962,1016)}D'après ce que nous avons vu jusqu'à présent...
Dialogue: 0,0:32:30.74,0:32:34.08,Default,,0,0,0,,{\pos(962,1016)}Ce monde est très différent du monde des petits points.
Dialogue: 0,0:32:34.16,0:32:36.54,Default,,0,0,0,,{\pos(962,1016)}Comment cet autre monde a-t-il été créé, je me demande ?
Dialogue: 0,0:32:37.56,0:32:39.74,Default,,0,0,0,,{\pos(962,1016)}Je me demande quelle est la vraie cause...
Dialogue: 0,0:32:46.98,0:32:49.02,Default,,0,0,0,,{\pos(962,1016)}Entre ces deux mondes...
Dialogue: 0,0:32:49.02,0:32:53.54,Default,,0,0,0,,{\pos(962,1016)}J'ai l'impression qu'il y a une différence frappante qui se cache.
Dialogue: 0,0:32:54.02,0:32:56.66,Default,,0,0,0,,{\pos(962,1016)}T'es sûr que tu n'imagines pas simplement des choses ?
Dialogue: 0,0:32:57.54,0:32:58.72,Default,,0,0,0,,{\pos(962,1016)}Hmmm... Peut-être.
Dialogue: 0,0:33:07.10,0:33:11.18,Default,,0,0,0,,{\pos(962,1016)}C'est comme si le monde des pores manquait de quelque chose que ce monde possède.
Dialogue: 0,0:33:11.18,0:33:15.26,Default,,0,0,0,,{\pos(962,1016)}Peu importe où tu cherches, il n'y a rien à voir !
Dialogue: 0,0:33:18.40,0:33:20.52,Default,,0,0,0,,{\pos(962,1016)}J'ai compris ! C'est cette baleine !
Dialogue: 0,0:33:20.52,0:33:22.52,Default,,0,0,0,,{\pos(962,1016)}À bien y penser... c'est vrai !
Dialogue: 0,0:33:22.86,0:33:23.72,Default,,0,0,0,,{\pos(962,1016)}Nya nya !
Dialogue: 0,0:33:23.78,0:33:26.12,Default,,0,0,0,,{\pos(962,1016)}Je connais cette baleine !
Dialogue: 0,0:33:32.76,0:33:36.08,Default,,0,0,0,,{\pos(962,1016)}J'ai vu cette baleine alors que j'achetais des barres de chocolat chez La bonbonnière !
Dialogue: 0,0:33:37.26,0:33:38.46,Default,,0,0,0,,{\pos(962,1016)}C'est ça !
Dialogue: 0,0:33:44.76,0:33:47.52,Default,,0,0,0,,{\pos(962,1016)}On dirait celui qui volait dans le ciel !
Dialogue: 0,0:33:47.52,0:33:48.84,Default,,0,0,0,,{\pos(962,1016)}Autrement dit...
Dialogue: 0,0:33:48.84,0:33:50.76,Default,,0,0,0,,{\pos(962,1016)}Alors c'est la vraie forme de cette baleine ?
Dialogue: 0,0:33:50.82,0:33:56.54,Default,,0,0,0,,{\pos(962,1016)}Mais qu’est-ce que ce signe a en lien avec l'autre baleine ?
Dialogue: 0,0:33:58.38,0:33:59.66,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que... !
Dialogue: 0,0:33:59.66,0:34:02.26,Default,,0,0,0,,{\pos(962,1016)}La confiserie a disparu !
Dialogue: 0,0:34:02.26,0:34:03.04,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce qui ne va pas ?
Dialogue: 0,0:34:03.04,0:34:06.34,Default,,0,0,0,,{\pos(962,1016)}Dans notre monde, la confiserie était ici !
Dialogue: 0,0:34:06.34,0:34:09.24,Default,,0,0,0,,{\pos(962,1016)}Je ne peux pas me procurer de barres de chocolat comme celles-ci.
Dialogue: 0,0:34:10.02,0:34:11.26,Default,,0,0,0,,{\pos(962,1016)}Hôpital... ?
Dialogue: 0,0:34:14.48,0:34:15.98,Default,,0,0,0,,{\pos(962,1016)}Calme-toi...
Dialogue: 0,0:34:16.58,0:34:17.50,Default,,0,0,0,,{\pos(962,1016)}Hé.
Dialogue: 0,0:34:17.50,0:34:19.06,Default,,0,0,0,,{\pos(962,1016)}Tu m'écoutes ?
Dialogue: 0,0:34:19.08,0:34:20.44,Default,,0,0,0,,{\pos(962,1016)}Du calme... ! Du calme... !
Dialogue: 0,0:34:20.44,0:34:22.44,Default,,0,0,0,,{\pos(962,1016)}Arrête-le déjà... Calme-toi...
Dialogue: 0,0:34:33.66,0:34:34.72,Default,,0,0,0,,{\pos(962,1016)}C'est ça !
Dialogue: 0,0:34:34.72,0:34:36.72,Default,,0,0,0,,{\pos(962,1016)}Je commence à comprendre !
Dialogue: 0,0:34:58.22,0:34:59.82,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que t'es ?
Dialogue: 0,0:34:59.82,0:35:01.82,Default,,0,0,0,,{\pos(962,1016)}C'est toi qui fais ça ?
Dialogue: 0,0:35:01.82,0:35:03.14,Default,,0,0,0,,{\pos(962,1016)}Qui es-tu ?
Dialogue: 0,0:35:03.92,0:35:05.48,Default,,0,0,0,,{\pos(962,1016)}Je m'appelle Nathan Adams...
Dialogue: 0,0:35:05.50,0:35:07.74,Default,,0,0,0,,{\pos(962,1016)}C'est un peu difficile à expliquer...
Dialogue: 0,0:35:08.62,0:35:11.50,Default,,0,0,0,,{\pos(962,1016)}Vous n'êtes pas de ce monde.
Dialogue: 0,0:35:11.50,0:35:13.08,Default,,0,0,0,,{\pos(962,1016)}C-C'est vrai.
Dialogue: 0,0:35:13.14,0:35:15.98,Default,,0,0,0,,{\pos(962,1016)}Je me suis perdu dans ce monde et...
Dialogue: 0,0:35:15.98,0:35:17.40,Default,,0,0,0,,{\pos(962,1016)}Et donc ?
Dialogue: 0,0:35:18.52,0:35:20.66,Default,,0,0,0,,{\pos(962,1016)}De toutes manières, nous ne pouvons pas laisser les choses ainsi.
Dialogue: 0,0:35:20.66,0:35:22.66,Default,,0,0,0,,{\pos(962,1016)}Nous devons faire tout redevenir comme avant.
Dialogue: 0,0:35:24.00,0:35:26.30,Default,,0,0,0,,{\pos(962,1016)}Ce n’est pas nécessaire.
Dialogue: 0,0:35:26.30,0:35:26.32,Default,,0,0,0,,{\pos(962,1016)}Mais pourquoi ? Ce n’est pas nécessaire.
Dialogue: 0,0:35:26.32,0:35:27.86,Default,,0,0,0,,{\pos(962,1016)}Mais pourquoi ?
Dialogue: 0,0:35:27.86,0:35:29.22,Default,,0,0,0,,{\pos(962,1016)}C'est bizarre.
Dialogue: 0,0:35:29.22,0:35:32.54,Default,,0,0,0,,{\pos(962,1016)}Je veux dire... On ne peut pas être à l'aise quand on n'est pas chez soi.
Dialogue: 0,0:35:33.54,0:35:35.06,Default,,0,0,0,,{\pos(962,1016)}Vraiment ?
Dialogue: 0,0:35:36.48,0:35:38.74,Default,,0,0,0,,{\pos(962,1016)}Mais c'est votre monde que j'aime le plus.
Dialogue: 0,0:35:49.52,0:35:51.16,Default,,0,0,0,,{\pos(962,1016)}Tout change encore !
Dialogue: 0,0:35:51.50,0:35:54.52,Default,,0,0,0,,{\pos(962,1016)}Alors c'est elle qui est à l'origine de tout ça !
Dialogue: 0,0:36:08.06,0:36:09.46,Default,,0,0,0,,{\pos(962,1016)}Elle vole ?!
Dialogue: 0,0:36:11.08,0:36:12.98,Default,,0,0,0,,{\pos(962,1016)}Ce monde est génial, n'est-ce pas ?
Dialogue: 0,0:36:13.58,0:36:14.98,Default,,0,0,0,,{\pos(962,1016)}Je suis tellement libre ici.
Dialogue: 0,0:36:29.38,0:36:31.04,Default,,0,0,0,,{\pos(962,1016)}Ça va les gars ?
Dialogue: 0,0:36:32.28,0:36:33.80,Default,,0,0,0,,{\pos(962,1016)}Allons la chercher !
Dialogue: 0,0:36:39.88,0:36:41.42,Default,,0,0,0,,{\pos(962,1016)}Attends !
Dialogue: 0,0:36:41.42,0:36:43.98,Default,,0,0,0,,{\pos(962,1016)}Je peux tout faire dans ce monde.
Dialogue: 0,0:36:43.98,0:36:45.98,Default,,0,0,0,,{\pos(962,1016)}Tout ce que envie.
Dialogue: 0,0:36:46.60,0:36:48.42,Default,,0,0,0,,{\pos(962,1016)}Écoute... Juste comme ça...
Dialogue: 0,0:36:49.34,0:36:51.12,Default,,0,0,0,,{\pos(962,1016)}C'est définitivement elle.
Dialogue: 0,0:36:51.12,0:36:53.18,Default,,0,0,0,,{\pos(962,1016)}Elle a appelé cette baleine...
Dialogue: 0,0:36:53.18,0:36:56.24,Default,,0,0,0,,{\pos(962,1016)}...et a permis de connecter notre monde et celui des petits points !
Dialogue: 0,0:37:06.06,0:37:07.96,Default,,0,0,0,,{\pos(962,1016)}Pourquoi me suis-tu ?
Dialogue: 0,0:37:08.48,0:37:09.70,Default,,0,0,0,,{\pos(962,1016)}Je veux...
Dialogue: 0,0:37:09.70,0:37:11.70,Default,,0,0,0,,{\pos(962,1016)}... t'aider à te sauver !
Dialogue: 0,0:37:12.56,0:37:15.00,Default,,0,0,0,,{\pos(962,1016)}Tu as une raison pour laquelle tu fais ça, n'est-ce pas ?
Dialogue: 0,0:37:15.00,0:37:17.00,Default,,0,0,0,,{\pos(962,1016)}Alors pourquoi tu fais ça ?
Dialogue: 0,0:37:35.38,0:37:36.98,Default,,0,0,0,,{\pos(962,1016)}C'est merveilleux.
Dialogue: 0,0:37:36.98,0:37:38.42,Default,,0,0,0,,{\pos(962,1016)}Trop cool, nya !
Dialogue: 0,0:37:38.42,0:37:40.08,Default,,0,0,0,,{\pos(962,1016)}Ce n’est pas le moment de regarder !
Dialogue: 0,0:37:40.08,0:37:41.46,Default,,0,0,0,,{\pos(962,1016)}Si ça doit être comme ça...
Dialogue: 0,0:37:41.46,0:37:42.88,Default,,0,0,0,,{\pos(962,1016)}Allez, mon amie...
Dialogue: 0,0:37:43.00,0:37:45.60,Default,,0,0,0,,{\pos(962,1016)}... à toi de jouer, Komama !
Dialogue: 0,0:37:45.60,0:37:47.84,Default,,0,0,0,,{\pos(962,1016)}Depuis quand es-tu devenu ami avec elle ?
Dialogue: 0,0:37:47.84,0:37:49.40,Default,,0,0,0,,{\pos(962,1016)}Komasan me l'a donné.
Dialogue: 0,0:37:49.46,0:37:52.14,Default,,0,0,0,,{\pos(962,1016)}Ma mère semble toujours seule...
Dialogue: 0,0:37:52.14,0:37:55.00,Default,,0,0,0,,{\pos(962,1016)}Pourquoi ne l'invoquerais-tu pas de temps en temps ?
Dialogue: 0,0:37:56.48,0:37:59.74,Default,,0,0,0,,{\pos(962,1016)}Ces explications sont toujours aussi douteuses !
Dialogue: 0,0:38:00.58,0:38:01.98,Default,,0,0,0,,{\pos(962,1016)}Médaille Yo-kai...
Dialogue: 0,0:38:01.98,0:38:03.98,Default,,0,0,0,,{\pos(962,1016)}... activation !
Dialogue: 0,0:38:03.98,0:38:06.42,Default,,0,0,0,,{\pos(962,1016)}Komama !
Dialogue: 0,0:38:07.42,0:38:08.70,Default,,0,0,0,,{\pos(962,1016)}Komama !
Dialogue: 0,0:38:08.70,0:38:10.70,Default,,0,0,0,,{\pos(962,1016)}Restez là !
Dialogue: 0,0:38:27.16,0:38:27.72,Default,,0,0,0,,{\pos(962,1016)}Bien !
Dialogue: 0,0:38:27.72,0:38:28.36,Default,,0,0,0,,{\pos(962,1016)}Oh oui !
Dialogue: 0,0:38:28.36,0:38:29.20,Default,,0,0,0,,{\pos(962,1016)}Tu l'as fait !
Dialogue: 0,0:38:29.20,0:38:31.74,Default,,0,0,0,,{\pos(962,1016)}Parce que le monde des petits points est son monde originel...
Dialogue: 0,0:38:31.74,0:38:33.42,Default,,0,0,0,,{\pos(962,1016)}... elle ne peut plus voler maintenant.
Dialogue: 0,0:38:34.28,0:38:38.46,Default,,0,0,0,,{\pos(962,1016)}J'ai compris cela après avoir réfléchi aux différences entre nos mondes.
Dialogue: 0,0:38:42.68,0:38:44.78,Default,,0,0,0,,{\pos(962,1016)}Pourquoi tu te moques de moi ?
Dialogue: 0,0:38:48.64,0:38:50.10,Default,,0,0,0,,{\pos(962,1016)}Je...
Dialogue: 0,0:38:50.68,0:38:53.44,Default,,0,0,0,,{\pos(962,1016)}Tout ce que je voulais, c'était danser.
Dialogue: 0,0:38:53.72,0:38:55.44,Default,,0,0,0,,{\pos(962,1016)}Danser ?
Dialogue: 0,0:38:57.00,0:38:58.88,Default,,0,0,0,,{\pos(962,1016)}Si je ne danse pas...
Dialogue: 0,0:39:00.72,0:39:02.04,Default,,0,0,0,,{\pos(962,1016)}... personne...
Dialogue: 0,0:39:02.04,0:39:04.04,Default,,0,0,0,,{\pos(962,1016)}... ne me regardera un jour...
Dialogue: 0,0:39:06.92,0:39:09.30,Default,,0,0,0,,{\pos(962,1016)}Je n'arrêterai jamais de danser !
Dialogue: 0,0:39:14.20,0:39:15.62,Default,,0,0,0,,{\pos(962,1016)}Toutouïe ?
Dialogue: 0,0:39:19.46,0:39:21.98,Default,,0,0,0,,{\pos(962,1016)}Oh ? Est-ce une vengeance pour la dernière fois ?
Dialogue: 0,0:39:25.32,0:39:27.60,Default,,0,0,0,,{\pos(962,1016)}La première fois que j'ai commencé la danse...
Dialogue: 0,0:39:27.60,0:39:29.60,Default,,0,0,0,,{\pos(962,1016)}... je n'étais encore qu'un petit enfant.
Dialogue: 0,0:40:09.98,0:40:12.56,Default,,0,0,0,,{\pos(962,1016)}Je suis tombée amoureuse du ballet à ce moment précis.
Dialogue: 0,0:40:16.06,0:40:17.76,Default,,0,0,0,,{\pos(962,1016)}Je m'appelle Kanami Minami.
Dialogue: 0,0:40:17.76,0:40:19.36,Default,,0,0,0,,{\pos(962,1016)}Enchantée !
Dialogue: 0,0:40:19.48,0:40:21.36,Default,,0,0,0,,{\pos(962,1016)}Enchantées !
Dialogue: 0,0:40:21.68,0:40:22.66,Default,,0,0,0,,{\pos(962,1016)}Nous...
Dialogue: 0,0:40:22.66,0:40:24.38,Default,,0,0,0,,{\pos(962,1016)}... ferons de notre mieux ensemble.
Dialogue: 0,0:40:24.38,0:40:25.18,Default,,0,0,0,,{\pos(962,1016)}Oui.
Dialogue: 0,0:40:54.98,0:40:57.06,Default,,0,0,0,,{\pos(962,1016)}Je l'ai fait ! Professeur !
Dialogue: 0,0:40:57.20,0:40:59.66,Default,,0,0,0,,{\pos(962,1016)}Kanami ! Tu as fait de ton mieux !
Dialogue: 0,0:40:59.66,0:41:01.66,Default,,0,0,0,,{\pos(962,1016)}Oui ! Merci professeur !
Dialogue: 0,0:41:03.92,0:41:05.30,Default,,0,0,0,,{\pos(962,1016)}À partir de ce jour,
Dialogue: 0,0:41:05.30,0:41:08.42,Default,,0,0,0,,{\pos(962,1016)}j'ai commencé à aimer de plus en plus le ballet.
Dialogue: 0,0:41:18.68,0:41:22.14,Default,,0,0,0,,{\pos(962,1016)}Professeur, je vais certainement gagner à ce concours !
Dialogue: 0,0:41:23.36,0:41:24.72,Default,,0,0,0,,{\pos(962,1016)}Oui.
Dialogue: 0,0:41:24.90,0:41:26.72,Default,,0,0,0,,{\pos(962,1016)}Tu peux certainement y arriver !
Dialogue: 0,0:41:27.52,0:41:28.72,Default,,0,0,0,,{\pos(962,1016)}Oui !
Dialogue: 0,0:41:35.30,0:41:36.84,Default,,0,0,0,,{\pos(962,1016)}Toutes nos félicitations.
Dialogue: 0,0:41:40.20,0:41:42.10,Default,,0,0,0,,{\pos(962,1016)}Merci beaucoup.
Dialogue: 0,0:41:51.98,0:41:53.62,Default,,0,0,0,,{\pos(962,1016)}Félicitations, Kanami !
Dialogue: 0,0:41:54.42,0:41:56.04,Default,,0,0,0,,{\pos(962,1016)}C'est un cadeau pour toi !
Dialogue: 0,0:41:56.76,0:41:58.28,Default,,0,0,0,,{\pos(962,1016)}Merci professeur.
Dialogue: 0,0:41:59.52,0:42:02.78,Default,,0,0,0,,{\pos(962,1016)}Tu vas entrer à l'académie de ballet maintenant.
Dialogue: 0,0:42:05.00,0:42:06.32,Default,,0,0,0,,{\pos(962,1016)}Kanami...
Dialogue: 0,0:42:06.84,0:42:08.40,Default,,0,0,0,,{\pos(962,1016)}...tu pourrais devenir...
Dialogue: 0,0:42:08.40,0:42:11.42,Default,,0,0,0,,{\pos(962,1016)}...la meilleure ballerine du monde entier !
Dialogue: 0,0:42:12.32,0:42:14.46,Default,,0,0,0,,{\pos(962,1016)}Avançons dans ce monde ensemble !
Dialogue: 0,0:42:15.94,0:42:16.96,Default,,0,0,0,,{\pos(962,1016)}Oui !
Dialogue: 0,0:42:17.08,0:42:18.90,Default,,0,0,0,,{\pos(962,1016)}Viser le sommet en tant que ballerine.
Dialogue: 0,0:42:19.50,0:42:20.64,Default,,0,0,0,,{\pos(962,1016)}Avant que je le sache,
Dialogue: 0,0:42:20.64,0:42:22.64,Default,,0,0,0,,{\pos(962,1016)}le ballet est devenu tout pour moi.
Dialogue: 0,0:42:24.38,0:42:25.62,Default,,0,0,0,,{\pos(962,1016)}Jusqu'à ce jour…
Dialogue: 0,0:42:30.30,0:42:32.10,Default,,0,0,0,,{\pos(962,1016)}Après cet accident soudain,
Dialogue: 0,0:42:32.60,0:42:35.14,Default,,0,0,0,,{\pos(962,1016)}j'ai dû arrêter de faire ce que j'aimais.
Dialogue: 0,0:42:35.74,0:42:37.82,Default,,0,0,0,,{\pos(962,1016)}... parce que je ne pourrais plus jamais danser.
Dialogue: 0,0:42:45.14,0:42:46.58,Default,,0,0,0,,{\pos(962,1016)}Non !
Dialogue: 0,0:42:47.10,0:42:48.74,Default,,0,0,0,,{\pos(962,1016)}Non !
Dialogue: 0,0:42:51.58,0:42:52.54,Default,,0,0,0,,{\pos(962,1016)}Non !
Dialogue: 0,0:42:52.54,0:42:54.54,Default,,0,0,0,,{\pos(962,1016)}Non ! Non !
Dialogue: 0,0:42:55.40,0:42:57.10,Default,,0,0,0,,{\pos(962,1016)}Non !
Dialogue: 0,0:43:16.06,0:43:18.20,Default,,0,0,0,,{\pos(962,1016)}Je voulais remonter le temps.
Dialogue: 0,0:43:19.80,0:43:21.84,Default,,0,0,0,,{\pos(962,1016)}Même si je savais que c'était impossible,
Dialogue: 0,0:43:22.26,0:43:25.04,Default,,0,0,0,,{\pos(962,1016)}J'ai souhaité ce miracle.
Dialogue: 0,0:43:32.50,0:43:33.80,Default,,0,0,0,,{\pos(962,1016)}À l'époque...
Dialogue: 0,0:43:34.44,0:43:35.96,Default,,0,0,0,,{\pos(962,1016)}... quand j'ai vu cette baleine.
Dialogue: 0,0:43:43.72,0:43:46.20,Default,,0,0,0,,{\pos(962,1016)}Si une baleine pouvait voler dans le ciel.
Dialogue: 0,0:43:48.62,0:43:52.78,Default,,0,0,0,,{\pos(962,1016)}Si je pouvais aller dans un monde où une chose aussi absurde pourrait arriver...
Dialogue: 0,0:43:52.90,0:43:56.32,Default,,0,0,0,,{\pos(962,1016)}... je pourrais faire ce que j'ai fait auparavant.
Dialogue: 0,0:43:58.48,0:44:00.14,Default,,0,0,0,,{\pos(962,1016)}C'est pourquoi.
Dialogue: 0,0:44:27.98,0:44:30.48,Default,,0,0,0,,{\pos(962,1016)}Ah ! La baleine est aussi dans ce monde !
Dialogue: 0,0:44:30.64,0:44:33.40,Default,,0,0,0,,{\pos(962,1016)}Cette fois-ci elle n’est pas dans l’autre monde ?
Dialogue: 0,0:44:33.40,0:44:35.86,Default,,0,0,0,,{\pos(962,1016)}Elle devient plus puissante...
Dialogue: 0,0:44:35.86,0:44:38.64,Default,,0,0,0,,{\pos(962,1016)}... assez pour invoquer la baleine dans ce monde aussi !
Dialogue: 0,0:44:38.70,0:44:40.62,Default,,0,0,0,,{\pos(962,1016)}Est-ce que c'est possible ?
Dialogue: 0,0:44:42.82,0:44:45.42,Default,,0,0,0,,{\pos(962,1016)}C'est possible.
Dialogue: 0,0:44:46.74,0:44:49.24,Default,,0,0,0,,{\pos(962,1016)}Elle n'est pas censée voler dans ce monde !
Dialogue: 0,0:44:49.38,0:44:52.28,Default,,0,0,0,,{\pos(962,1016)}Qu'allons-nous faire maintenant?
Dialogue: 0,0:44:55.28,0:44:56.96,Default,,0,0,0,,{\pos(962,1016)}Courez après elle !
Dialogue: 0,0:45:10.20,0:45:11.28,Default,,0,0,0,,{\pos(962,1016)}Nathan ?
Dialogue: 0,0:45:11.78,0:45:14.00,Default,,0,0,0,,{\pos(962,1016)}Nathan !
Dialogue: 0,0:45:20.66,0:45:22.06,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que...
Dialogue: 0,0:45:23.50,0:45:24.78,Default,,0,0,0,,{\pos(962,1016)}Une école de danse ?
Dialogue: 0,0:45:26.54,0:45:29.64,Default,,0,0,0,,{\pos(962,1016)}Peut-être que Kanami est revenue ici ?
Dialogue: 0,0:45:31.08,0:45:33.70,Default,,0,0,0,,{\pos(962,1016)}Faisons une pause de dix minutes.
Dialogue: 0,0:45:33.70,0:45:34.60,Default,,0,0,0,,{\pos(962,1016)}D'accord !
Dialogue: 0,0:45:34.60,0:45:36.60,Default,,0,0,0,,{\pos(962,1016)}N'oubliez pas vos affaires.
Dialogue: 0,0:45:40.56,0:45:42.22,Default,,0,0,0,,{\pos(962,1016)}Euh... Excusez-moi.
Dialogue: 0,0:45:42.22,0:45:43.78,Default,,0,0,0,,{\pos(962,1016)}Êtes-vous...
Dialogue: 0,0:45:43.78,0:45:45.78,Default,,0,0,0,,{\pos(962,1016)}Êtes-vous le professeur de Kanami ?
Dialogue: 0,0:45:48.20,0:45:49.72,Default,,0,0,0,,{\pos(962,1016)}Et tu es ?
Dialogue: 0,0:45:51.66,0:45:53.66,Default,,0,0,0,,{\pos(962,1016)}Nous...
Dialogue: 0,0:45:53.66,0:45:56.66,Default,,0,0,0,,{\pos(962,1016)}Elle a toujours travaillé plus dur que quiconque.
Dialogue: 0,0:45:57.96,0:46:00.74,Default,,0,0,0,,{\pos(962,1016)}Quand elle dansait...
Dialogue: 0,0:46:00.74,0:46:02.42,Default,,0,0,0,,{\pos(962,1016)}Elle était plus énergique...
Dialogue: 0,0:46:02.42,0:46:04.42,Default,,0,0,0,,{\pos(962,1016)}... et plus motivée que quiconque.
Dialogue: 0,0:46:05.74,0:46:07.70,Default,,0,0,0,,{\pos(962,1016)}Mais quand c'est arrivé...
Dialogue: 0,0:46:10.00,0:46:11.74,Default,,0,0,0,,{\pos(962,1016)}Vous voulez dire l'accident ?
Dialogue: 0,0:46:15.72,0:46:16.78,Default,,0,0,0,,{\pos(962,1016)}Oui.
Dialogue: 0,0:46:19.84,0:46:21.68,Default,,0,0,0,,{\pos(962,1016)}Pour elle...
Dialogue: 0,0:46:21.68,0:46:23.68,Default,,0,0,0,,{\pos(962,1016)}La danse était tout.
Dialogue: 0,0:46:24.56,0:46:28.18,Default,,0,0,0,,{\pos(962,1016)}C'était son rêve de devenir une partie du ballet international.
Dialogue: 0,0:46:28.86,0:46:31.62,Default,,0,0,0,,{\pos(962,1016)}Mais ce rêve...
Dialogue: 0,0:46:32.08,0:46:33.80,Default,,0,0,0,,{\pos(962,1016)}... à cause de cet accident...
Dialogue: 0,0:46:33.80,0:46:35.80,Default,,0,0,0,,{\pos(962,1016)}Elle a dû l'abandonner.
Dialogue: 0,0:46:36.42,0:46:38.04,Default,,0,0,0,,{\pos(962,1016)}C'est vraiment triste.
Dialogue: 0,0:46:38.84,0:46:40.08,Default,,0,0,0,,{\pos(962,1016)}Ça l'est.
Dialogue: 0,0:46:40.86,0:46:42.48,Default,,0,0,0,,{\pos(962,1016)}Mais...
Dialogue: 0,0:46:42.70,0:46:45.52,Default,,0,0,0,,{\pos(962,1016)}C'était sa propre décision d'abandonner.
Dialogue: 0,0:46:45.66,0:46:46.98,Default,,0,0,0,,{\pos(962,1016)}Hein ?
Dialogue: 0,0:46:46.98,0:46:48.98,Default,,0,0,0,,{\pos(962,1016)}Que veux-tu dire ?
Dialogue: 0,0:46:55.10,0:46:57.14,Default,,0,0,0,,{\pos(962,1016)}Qu'allons-nous faire maintenant ?
Dialogue: 0,0:46:57.14,0:46:59.48,Default,,0,0,0,,{\pos(962,1016)}Je vais définitivement sauver Kanami !
Dialogue: 0,0:46:59.60,0:47:01.48,Default,,0,0,0,,{\pos(962,1016)}Que veux-tu dire ?
Dialogue: 0,0:47:01.48,0:47:02.88,Default,,0,0,0,,{\pos(962,1016)}Allez mes amis !
Dialogue: 0,0:47:02.88,0:47:04.62,Default,,0,0,0,,{\pos(962,1016)}À vous de jouer, Kyubi,
Dialogue: 0,0:47:04.62,0:47:05.38,Default,,0,0,0,,{\pos(962,1016)}Octorgone,
Dialogue: 0,0:47:05.38,0:47:06.78,Default,,0,0,0,,{\pos(962,1016)}Robonyan F !
Dialogue: 0,0:47:06.86,0:47:09.42,Default,,0,0,0,,{\pos(962,1016)}Médailles Yo-kai, activation !
Dialogue: 0,0:47:12.48,0:47:13.88,Default,,0,0,0,,{\pos(962,1016)}Kyubi.
Dialogue: 0,0:47:14.90,0:47:16.24,Default,,0,0,0,,{\pos(962,1016)}Octorgone.
Dialogue: 0,0:47:16.62,0:47:18.12,Default,,0,0,0,,{\pos(962,1016)}Robonyan F.
Dialogue: 0,0:47:18.52,0:47:21.48,Default,,0,0,0,,{\pos(962,1016)}Il y a quelqu'un que je dois retrouver. S'il vous plaît !
Dialogue: 0,0:47:23.26,0:47:25.18,Default,,0,0,0,,{\pos(962,1016)}Je vais la trouver pour toi.
Dialogue: 0,0:47:32.90,0:47:34.58,Default,,0,0,0,,{\pos(962,1016)}Cherchons-la aussi !
Dialogue: 0,0:47:34.58,0:47:36.12,Default,,0,0,0,,{\pos(962,1016)}Compris !
Dialogue: 0,0:47:36.12,0:47:37.58,Default,,0,0,0,,{\pos(962,1016)}Laisse-moi faire !
Dialogue: 0,0:47:37.58,0:47:39.58,Default,,0,0,0,,{\pos(962,1016)}Compris !
Dialogue: 0,0:47:47.20,0:47:48.64,Default,,0,0,0,,{\pos(962,1016)}Est-ce que c'est elle ?
Dialogue: 0,0:47:49.56,0:47:51.78,Default,,0,0,0,,{\pos(962,1016)}Nathan ? Tu m'entends ?
Dialogue: 0,0:47:51.78,0:47:53.12,Default,,0,0,0,,{\pos(962,1016)}Je l'ai trouvée.
Dialogue: 0,0:47:53.12,0:47:55.12,Default,,0,0,0,,{\pos(962,1016)}Vers l'ouest.
Dialogue: 0,0:48:05.98,0:48:07.26,Default,,0,0,0,,{\pos(962,1016)}Elle vole !
Dialogue: 0,0:48:07.26,0:48:09.26,Default,,0,0,0,,{\pos(962,1016)}Incroyable !
Dialogue: 0,0:48:12.32,0:48:13.84,Default,,0,0,0,,{\pos(962,1016)}Quelque chose ne va pas...
Dialogue: 0,0:48:29.04,0:48:30.48,Default,,0,0,0,,{\pos(962,1016)}Pour...
Dialogue: 0,0:48:39.56,0:48:41.86,Default,,0,0,0,,{\pos(962,1016)}Pourquoi Kanami fait ça ?
Dialogue: 0,0:48:42.26,0:48:44.00,Default,,0,0,0,,{\pos(962,1016)}C'est son chagrin.
Dialogue: 0,0:48:45.04,0:48:47.72,Default,,0,0,0,,{\pos(962,1016)}C'est l'obscurité du chagrin dans son cœur.
Dialogue: 0,0:48:47.72,0:48:50.84,Default,,0,0,0,,{\pos(962,1016)}C'est ce qui lie notre monde au sien.
Dialogue: 0,0:48:50.86,0:48:53.30,Default,,0,0,0,,{\pos(962,1016)}Si cela continue, elle cessera d'être humaine.
Dialogue: 0,0:48:53.30,0:48:53.98,Default,,0,0,0,,{\pos(962,1016)}Hein ?
Dialogue: 0,0:48:53.98,0:48:57.12,Default,,0,0,0,,{\pos(962,1016)}Nous devons combattre cette obscurité qui l’a envahi !
Dialogue: 0,0:48:59.06,0:49:00.26,Default,,0,0,0,,{\pos(962,1016)}Mais comment ?
Dialogue: 0,0:49:00.26,0:49:01.58,Default,,0,0,0,,{\pos(962,1016)}Laisse-moi faire !
Dialogue: 0,0:49:02.16,0:49:05.10,Default,,0,0,0,,{\pos(962,1016)}C'est la raison pour laquelle je suis revenu.
Dialogue: 0,0:49:09.86,0:49:11.34,Default,,0,0,0,,{\pos(962,1016)}Mon seigneur...
Dialogue: 0,0:49:12.34,0:49:13.78,Default,,0,0,0,,{\pos(962,1016)}C'est...
Dialogue: 0,0:49:15.98,0:49:17.88,Default,,0,0,0,,{\pos(962,1016)}Tu l'as remarqué ? Zazel ?
Dialogue: 0,0:49:18.22,0:49:19.22,Default,,0,0,0,,{\pos(962,1016)}Oui.
Dialogue: 0,0:49:20.64,0:49:22.26,Default,,0,0,0,,{\pos(962,1016)}J'ai un très mauvais pressentiment.
Dialogue: 0,0:49:24.14,0:49:26.36,Default,,0,0,0,,{\pos(962,1016)}Mon apparence, qui était tout simplement belle...
Dialogue: 0,0:49:27.16,0:49:30.86,Default,,0,0,0,,{\pos(962,1016)}... semble avoir évolué à la perfection.
Dialogue: 0,0:49:30.86,0:49:32.58,Default,,0,0,0,,{\pos(962,1016)}Seigneur Enma !
Dialogue: 0,0:49:33.34,0:49:34.66,Default,,0,0,0,,{\pos(962,1016)}C'est comme si...
Dialogue: 0,0:49:34.68,0:49:37.24,Default,,0,0,0,,{\pos(962,1016)}... le piquant qui reflette mon visage...
Dialogue: 0,0:49:37.28,0:49:40.06,Default,,0,0,0,,{\pos(962,1016)}... crachait des feux de l'enfer...
Dialogue: 0,0:49:40.10,0:49:43.92,Default,,0,0,0,,{\pos(962,1016)}... un concentré de chaleur charmante m'a été doté.
Dialogue: 0,0:49:44.30,0:49:45.86,Default,,0,0,0,,{\pos(962,1016)}Seigneur Enma...
Dialogue: 0,0:49:46.22,0:49:48.02,Default,,0,0,0,,{\pos(962,1016)}J'ai aussi l'impression d'avoir...
Dialogue: 0,0:49:48.02,0:49:50.02,Default,,0,0,0,,{\pos(962,1016)}... absorbé une partie de cette chaleur...
Dialogue: 0,0:49:50.50,0:49:53.32,Default,,0,0,0,,{\pos(962,1016)}... s'ajoutant à mon charme et à ma beauté.
Dialogue: 0,0:49:58.18,0:50:00.44,Default,,0,0,0,,{\pos(962,1016)}Que s'est-il passé ?
Dialogue: 0,0:50:01.74,0:50:02.72,Default,,0,0,0,,{\pos(962,1016)}Peut-être...
Dialogue: 0,0:50:04.36,0:50:05.52,Default,,0,0,0,,{\pos(962,1016)}♪ Enma ! ♪
Dialogue: 0,0:50:05.52,0:50:07.30,Default,,0,0,0,,{\pos(962,1016)}♪ Enma ! ♪
Dialogue: 0,0:50:07.30,0:50:10.04,Default,,0,0,0,,{\pos(962,1016)}♪ Oui c’est lui, c’est Enma ! ♪
Dialogue: 0,0:50:07.72,0:50:10.04,Default,,0,0,0,,{\pos(962,1016)}Mon corps bouge tout seul !
Dialogue: 0,0:50:10.04,0:50:10.14,Default,,0,0,0,,{\pos(962,1016)}Mon corps bouge tout seul !
Dialogue: 0,0:50:10.14,0:50:11.28,Default,,0,0,0,,{\pos(962,1016)}Zazel, concen...
Dialogue: 0,0:50:11.28,0:50:11.72,Default,,0,0,0,,{\pos(962,1016)}Zazel, concen...
Dialogue: 0,0:50:11.72,0:50:12.52,Default,,0,0,0,,{\pos(962,1016)}♪ Enma ! Enma ! ♪
Dialogue: 0,0:50:12.52,0:50:14.30,Default,,0,0,0,,{\pos(962,1016)}♪ Enma ! Enma ! ♪
Dialogue: 0,0:50:14.30,0:50:16.78,Default,,0,0,0,,{\pos(962,1016)}♪ Oui c’est lui c’est Enma ! ♪
Dialogue: 0,0:50:15.40,0:50:16.78,Default,,0,0,0,,{\pos(962,1016)}Ça m'a eu aussi !
Dialogue: 0,0:50:16.78,0:50:16.86,Default,,0,0,0,,{\pos(962,1016)}Ça m'a eu aussi !
Dialogue: 0,0:50:17.08,0:50:18.66,Default,,0,0,0,,{\pos(962,1016)}Notre beauté.... !
Dialogue: 0,0:50:18.76,0:50:20.34,Default,,0,0,0,,{\pos(962,1016)}... est écransante !
Dialogue: 0,0:50:21.08,0:50:22.16,Default,,0,0,0,,{\pos(962,1016)}Est-ce ainsi ?
Dialogue: 0,0:50:26.64,0:50:29.16,Default,,0,0,0,,{\pos(962,1016)}L'étrange phénomène dans le monde humain...
Dialogue: 0,0:50:29.16,0:50:31.16,Default,,0,0,0,,{\pos(962,1016)}... a étendu son influence ici aussi !
Dialogue: 0,0:50:33.06,0:50:34.94,Default,,0,0,0,,{\pos(962,1016)}C'est vrai.
Dialogue: 0,0:50:45.50,0:50:47.52,Default,,0,0,0,,{\pos(962,1016)}Alors ce que tu dis...
Dialogue: 0,0:50:48.54,0:50:50.98,Default,,0,0,0,,{\pos(962,1016)}C'est que ces deux mondes se sont mélangés...
Dialogue: 0,0:50:50.98,0:50:52.54,Default,,0,0,0,,{\pos(962,1016)}Dans ce cas, Hovernyan.
Dialogue: 0,0:50:52.78,0:50:56.86,Default,,0,0,0,,{\pos(962,1016)}Je voudrais que tu enquêtes sur la situation pour moi.
Dialogue: 0,0:50:56.92,0:50:58.22,Default,,0,0,0,,{\pos(962,1016)}Oui.
Dialogue: 0,0:51:21.28,0:51:22.76,Default,,0,0,0,,{\pos(962,1016)}Il paraît que...
Dialogue: 0,0:51:22.76,0:51:28.92,Default,,0,0,0,,{\pos(962,1016)}... les ténèbres s’emparent d’un humain puissant au cœur très fort.
Dialogue: 0,0:51:30.16,0:51:32.24,Default,,0,0,0,,{\pos(962,1016)}Un mal né du cœur des humains.
Dialogue: 0,0:51:33.02,0:51:35.76,Default,,0,0,0,,{\pos(962,1016)}Je sens la présence de ce mal pur.
Dialogue: 0,0:51:38.20,0:51:41.30,Default,,0,0,0,,{\pos(962,1016)}Zazel, apporte-moi ça.
Dialogue: 0,0:51:41.32,0:51:42.04,Default,,0,0,0,,{\pos(962,1016)}Compris.
Dialogue: 0,0:51:49.76,0:51:51.68,Default,,0,0,0,,{\pos(962,1016)}Cela devrait suffire.
Dialogue: 0,0:51:54.86,0:51:56.14,Default,,0,0,0,,{\pos(962,1016)}C'est... !
Dialogue: 0,0:51:57.14,0:51:58.62,Default,,0,0,0,,{\pos(962,1016)}Elle s'appelle...
Dialogue: 0,0:51:58.62,0:52:00.62,Default,,0,0,0,,{\pos(962,1016)}... l’Épée Enma.
Dialogue: 0,0:52:01.82,0:52:05.34,Default,,0,0,0,,{\pos(962,1016)}L’épée de la lignée Enma.
Dialogue: 0,0:52:05.60,0:52:07.24,Default,,0,0,0,,{\pos(962,1016)}C'est plein d'esprit, non ?
Dialogue: 0,0:52:07.24,0:52:10.62,Default,,0,0,0,,{\pos(962,1016)}Ce n'est pas seulement plein d'esprit... C'est aussi peu original.
Dialogue: 0,0:52:10.68,0:52:13.70,Default,,0,0,0,,{\pos(962,1016)}Avec cette lame, les ténèbres qui inspirent les humains sont...
Dialogue: 0,0:52:20.96,0:52:21.24,Default,,0,0,0,,{\pos(962,1016)}♪ Enma... ♪
Dialogue: 0,0:52:21.24,0:52:22.12,Default,,0,0,0,,{\pos(962,1016)}Zazel, ne m'oublie pas !
Dialogue: 0,0:52:21.24,0:52:22.12,Default,,0,0,0,,{\pos(962,1016)}♪ Enma... ♪
Dialogue: 0,0:52:22.12,0:52:22.70,Default,,0,0,0,,{\pos(962,1016)}♪ Enma... ♪
Dialogue: 0,0:52:22.70,0:52:23.82,Default,,0,0,0,,{\pos(962,1016)}♪ Enma ! ♪
Dialogue: 0,0:52:23.82,0:52:26.38,Default,,0,0,0,,{\pos(962,1016)}♪ Oui c'est lui ! C'est Enma ! ♪
Dialogue: 0,0:52:26.98,0:52:28.14,Default,,0,0,0,,{\pos(962,1016)}♪ Enma... ♪
Dialogue: 0,0:52:28.30,0:52:29.58,Default,,0,0,0,,{\pos(962,1016)}♪ Enma ! ♪
Dialogue: 0,0:52:29.82,0:52:32.88,Default,,0,0,0,,{\pos(962,1016)}♪ Oui c'est lui ! C'est Enma ! ♪
Dialogue: 0,0:52:33.60,0:52:36.76,Default,,0,0,0,,{\pos(962,1016)}♪ Enma... Enma... ♪
Dialogue: 0,0:52:36.86,0:52:40.96,Default,,0,0,0,,{\pos(962,1016)}♪ Enma ! ♪
Dialogue: 0,0:52:48.58,0:52:50.00,Default,,0,0,0,,{\pos(962,1016)}Voilà donc...
Dialogue: 0,0:52:50.00,0:52:51.14,Default,,0,0,0,,{\pos(962,1016)}L'Épée Enma !
Dialogue: 0,0:52:52.00,0:52:54.00,Default,,0,0,0,,{\pos(962,1016)}Euh... donc !
Dialogue: 0,0:52:54.00,0:52:56.82,Default,,0,0,0,,{\pos(962,1016)}Tranche le pouvoir des ténèbres avec !
Dialogue: 0,0:52:56.82,0:52:59.52,Default,,0,0,0,,{\pos(962,1016)}Le pouvoir... des ténèbres ?
Dialogue: 0,0:53:06.70,0:53:08.52,Default,,0,0,0,,{\pos(962,1016)}Yo-kai Watch !
Dialogue: 0,0:53:09.78,0:53:12.18,Default,,0,0,0,,{\pos(962,1016)}Rêvolution !
Dialogue: 0,0:53:12.18,0:53:13.84,Default,,0,0,0,,{\pos(962,1016)}Médaille du Seigneur Enma...
Dialogue: 0,0:53:13.84,0:53:15.84,Default,,0,0,0,,{\pos(962,1016)}... activation !
Dialogue: 0,0:53:15.96,0:53:16.88,Default,,0,0,0,,{\pos(962,1016)}Seigneur Enma !
Dialogue: 0,0:53:18.22,0:53:19.48,Default,,0,0,0,,{\pos(962,1016)}Seigneur Enma !
Dialogue: 0,0:53:19.48,0:53:20.92,Default,,0,0,0,,{\pos(962,1016)}C'est un katana !
Dialogue: 0,0:53:20.92,0:53:25.32,Default,,0,0,0,,{\pos(962,1016)}C'est le pouvoir du bon Enma !
Dialogue: 0,0:53:26.38,0:53:27.46,Default,,0,0,0,,{\pos(962,1016)}Entends-moi...
Dialogue: 0,0:53:27.46,0:53:30.34,Default,,0,0,0,,{\pos(962,1016)}Pouvoir de la lignée Enma, activation !
Dialogue: 0,0:53:47.82,0:53:48.86,Default,,0,0,0,,{\pos(962,1016)}Yes !
Dialogue: 0,0:54:10.78,0:54:11.60,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que c'est ?
Dialogue: 0,0:54:11.60,0:54:13.14,Default,,0,0,0,,{\pos(962,1016)}Un, un...
Dialogue: 0,0:54:13.14,0:54:15.66,Default,,0,0,0,,{\pos(962,1016)}C'est le grand démon Yo-kai, Ténorque !
Dialogue: 0,0:54:15.66,0:54:16.72,Default,,0,0,0,,{\pos(962,1016)}Et c'est qui, exactement ?
Dialogue: 0,0:54:16.72,0:54:19.38,Default,,0,0,0,,{\pos(962,1016)}Un cœur de ténèbres né de l’intérieur des humains…
Dialogue: 0,0:54:19.38,0:54:21.54,Default,,0,0,0,,{\pos(962,1016)}... envoûté par la volonté des Perfides.
Dialogue: 0,0:54:21.54,0:54:23.54,Default,,0,0,0,,{\pos(962,1016)}C'est mon discours !
Dialogue: 0,0:54:34.68,0:54:36.02,Default,,0,0,0,,{\pos(962,1016)}Oh non !
Dialogue: 0,0:54:53.18,0:54:55.44,Default,,0,0,0,,{\pos(962,1016)}Je vais... continuer à danser !
Dialogue: 0,0:55:04.12,0:55:05.54,Default,,0,0,0,,{\pos(962,1016)}Ce n'est pas possible !
Dialogue: 0,0:55:08.38,0:55:09.80,Default,,0,0,0,,{\pos(962,1016)}Sois prudent ! Nathan !
Dialogue: 0,0:55:10.58,0:55:12.48,Default,,0,0,0,,{\pos(962,1016)}Si tu les laisses comme ça...
Dialogue: 0,0:55:12.48,0:55:14.32,Default,,0,0,0,,{\pos(962,1016)}Cela détruira nos deux mondes !
Dialogue: 0,0:55:15.24,0:55:17.50,Default,,0,0,0,,{\pos(962,1016)}On doit absolument vaincre Ténorque !
Dialogue: 0,0:55:17.50,0:55:19.14,Default,,0,0,0,,{\pos(962,1016)}Faisons-le alors !
Dialogue: 0,0:55:19.68,0:55:21.70,Default,,0,0,0,,{\pos(962,1016)}Faisons-le pour elle.
Dialogue: 0,0:55:22.18,0:55:24.26,Default,,0,0,0,,{\pos(962,1016)}Je peux enfin danser maintenant...
Dialogue: 0,0:55:24.26,0:55:26.26,Default,,0,0,0,,{\pos(962,1016)}... alors ne me gênez pas !
Dialogue: 0,0:55:46.16,0:55:47.72,Default,,0,0,0,,{\pos(962,1016)}Merci Octorgone !
Dialogue: 0,0:55:47.72,0:55:49.34,Default,,0,0,0,,{\pos(962,1016)}Pas besoin de me remercier.
Dialogue: 0,0:55:49.34,0:55:52.58,Default,,0,0,0,,{\pos(962,1016)}Il n'y a aucune honte à compter sur nous !
Dialogue: 0,0:55:53.24,0:55:56.38,Default,,0,0,0,,{\pos(962,1016)}Ouah ! Ces deux-là sont tellement cool !
Dialogue: 0,0:55:56.38,0:55:57.92,Default,,0,0,0,,{\pos(962,1016)}Mouah !
Dialogue: 0,0:56:14.18,0:56:15.52,Default,,0,0,0,,{\pos(962,1016)}Génial !
Dialogue: 0,0:56:15.52,0:56:18.12,Default,,0,0,0,,{\pos(962,1016)}Ça, c'est les Octorgone et Kyubi que je connais !
Dialogue: 0,0:56:21.28,0:56:22.42,Default,,0,0,0,,{\pos(962,1016)}Il essaie de s'enfuir ?!
Dialogue: 0,0:56:22.54,0:56:23.88,Default,,0,0,0,,{\pos(962,1016)}Il a disparu !
Dialogue: 0,0:56:36.76,0:56:39.58,Default,,0,0,0,,{\pos(962,1016)}On dirait qu'il veut se battre sérieusement !
Dialogue: 0,0:56:41.42,0:56:42.34,Default,,0,0,0,,{\pos(962,1016)}Quoi... ?
Dialogue: 0,0:56:42.34,0:56:45.90,Default,,0,0,0,,{\pos(962,1016)}On dirait qu'Octorgone et Kyubi libèrent leur véritable pouvoir !
Dialogue: 0,0:56:46.08,0:56:47.10,Default,,0,0,0,,{\pos(962,1016)}Hein ?
Dialogue: 0,0:56:52.98,0:56:55.76,Default,,0,0,0,,{\pos(962,1016)}Ils ont aussi l'air trop cool dans ce monde !
Dialogue: 0,0:57:03.26,0:57:06.24,Default,,0,0,0,,{\pos(962,1016)}LUMINOCT | OBSKYURBI
Dialogue: 0,0:57:03.84,0:57:05.92,Default,,0,0,0,,{\pos(962,1016)}Nous allons te vaincre !
Dialogue: 0,0:57:06.24,0:57:07.36,Default,,0,0,0,,{\pos(962,1016)}Quand nous mettrons fin à ce combat...
Dialogue: 0,0:57:07.36,0:57:08.38,Default,,0,0,0,,{\pos(962,1016)}Il faut qu'on termine ce combat...
Dialogue: 0,0:57:15.18,0:57:16.36,Default,,0,0,0,,{\pos(962,1016)}C'était quoi ça ?!
Dialogue: 0,0:57:16.36,0:57:17.94,Default,,0,0,0,,{\pos(962,1016)}... ils étaient occupés à parler !
Dialogue: 0,0:57:17.98,0:57:19.98,Default,,0,0,0,,{\pos(962,1016)}Comme c’est déshonorant !
Dialogue: 0,0:57:25.22,0:57:27.20,Default,,0,0,0,,{\pos(962,1016)}Comme c'est cruel...
Dialogue: 0,0:57:27.28,0:57:30.24,Default,,0,0,0,,{\pos(962,1016)}Ne sommes-nous pas plus faibles dans ce monde ?
Dialogue: 0,0:57:30.68,0:57:32.22,Default,,0,0,0,,{\pos(962,1016)}On dirait que c'est le cas.
Dialogue: 0,0:57:32.36,0:57:33.80,Default,,0,0,0,,{\pos(962,1016)}Dans ce cas...
Dialogue: 0,0:57:35.40,0:57:36.28,Default,,0,0,0,,{\pos(962,1016)}C'est ici...
Dialogue: 0,0:57:44.10,0:57:46.12,Default,,0,0,0,,{\pos(962,1016)}Maintenant, laissez-moi faire !
Dialogue: 0,0:57:46.92,0:57:48.94,Default,,0,0,0,,{\pos(962,1016)}Je te soutiendrai !
Dialogue: 0,0:57:53.24,0:57:54.42,Default,,0,0,0,,{\pos(962,1016)}Bien sûr...
Dialogue: 0,0:57:59.76,0:58:02.42,Default,,0,0,0,,{\pos(962,1016)}Par la fureur du chaton !
Dialogue: 0,0:58:08.96,0:58:09.96,Default,,0,0,0,,{\pos(962,1016)}Quoi ?
Dialogue: 0,0:58:13.84,0:58:17.82,Default,,0,0,0,,{\pos(962,1016)}La fureur du chaton devient pathétiquement réaliste !
Dialogue: 0,0:58:17.82,0:58:19.82,Default,,0,0,0,,{\pos(962,1016)}Ce n'est pas bon... !
Dialogue: 0,0:58:27.14,0:58:31.16,Default,,0,0,0,,{\pos(962,1016)}C'est trop dangereux de tomber de si haut !
Dialogue: 0,0:58:34.06,0:58:36.04,Default,,0,0,0,,{\pos(962,1016)}Que faites-vous ?
Dialogue: 0,0:58:36.04,0:58:37.32,Default,,0,0,0,,{\pos(962,1016)}Par ici Jibanyan !
Dialogue: 0,0:58:54.62,0:58:56.00,Default,,0,0,0,,{\pos(962,1016)}Bien ! C'est notre chance !
Dialogue: 0,0:59:02.34,0:59:05.22,Default,,0,0,0,,{\pos(962,1016)}Ah ! Fureur du chaton !
Dialogue: 0,0:59:10.98,0:59:12.32,Default,,0,0,0,,{\pos(962,1016)}Ouais !
Dialogue: 0,0:59:20.20,0:59:22.98,Default,,0,0,0,,{\pos(962,1016)}Oh non ! Pas encore... !
Dialogue: 0,0:59:26.84,0:59:28.76,Default,,0,0,0,,{\pos(962,1016)}Laisse-le moi !
Dialogue: 0,0:59:31.52,0:59:33.92,Default,,0,0,0,,{\pos(962,1016)}L'échec est un déshonneur pour un guerrier !
Dialogue: 0,0:59:41.30,0:59:43.20,Default,,0,0,0,,{\pos(962,1016)}Shogunyan ! Sois prudent !
Dialogue: 0,0:59:43.62,0:59:45.64,Default,,0,0,0,,{\pos(962,1016)}Il n’y a pas lieu de s’inquiéter.
Dialogue: 0,0:59:45.64,0:59:47.02,Default,,0,0,0,,{\pos(962,1016)}Je n'ai pas l'intention de perdre...
Dialogue: 0,0:59:51.72,0:59:54.82,Default,,0,0,0,,{\pos(962,1016)}Tu disais ? Ça s'est fini comme la dernière fois !
Dialogue: 0,1:00:00.10,1:00:02.72,Default,,0,0,0,,{\pos(962,1016)}Tss, ce n'est pas équitable.
Dialogue: 0,1:00:14.86,1:00:17.92,Default,,0,0,0,,{\pos(962,1016)}Nous allons devoir le combattre d'une manière différente.
Dialogue: 0,1:00:23.54,1:00:25.44,Default,,0,0,0,,{\pos(962,1016)}Les gars !
Dialogue: 0,1:00:27.02,1:00:28.26,Default,,0,0,0,,{\pos(962,1016)}Komajiro !
Dialogue: 0,1:00:28.26,1:00:30.26,Default,,0,0,0,,{\pos(962,1016)}Essaie d'utiliser ça !
Dialogue: 0,1:00:34.16,1:00:35.46,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que c'est ça?
Dialogue: 0,1:00:35.46,1:00:37.46,Default,,0,0,0,,{\pos(962,1016)}C'est le Bazooka Yo-kai !
Dialogue: 0,1:00:37.46,1:00:39.68,Default,,0,0,0,,{\pos(962,1016)}Je me souvenais qu'il y avait quelque chose comme ça...
Dialogue: 0,1:00:39.68,1:00:43.18,Default,,0,0,0,,{\pos(962,1016)}... alors je suis allé le commander par correspondance Yo-kai.
Dialogue: 0,1:00:43.18,1:00:45.78,Default,,0,0,0,,{\pos(962,1016)}Ça devient un peu long !
Dialogue: 0,1:00:45.78,1:00:49.88,Default,,0,0,0,,{\pos(962,1016)}Je suis quand même un peu soulagé d'être de retour dans ce monde.
Dialogue: 0,1:00:49.88,1:00:53.30,Default,,0,0,0,,{\pos(962,1016)}On dirait que nous faisons des progrès en rassemblant des choses.
Dialogue: 0,1:00:54.12,1:00:54.68,Default,,0,0,0,,{\pos(962,1016)}Oui !
Dialogue: 0,1:00:54.72,1:00:56.76,Default,,0,0,0,,{\pos(962,1016)}Yo-kai Watch !
Dialogue: 0,1:00:59.62,1:01:01.54,Default,,0,0,0,,{\pos(962,1016)}Rêvolution !
Dialogue: 0,1:01:01.54,1:01:04.06,Default,,0,0,0,,{\pos(962,1016)}À toi de jouer !
Dialogue: 0,1:01:04.06,1:01:05.22,Default,,0,0,0,,{\pos(962,1016)}Feulion !
Dialogue: 0,1:01:05.22,1:01:07.38,Default,,0,0,0,,{\pos(962,1016)}Médaille Yo-kai, activation !
Dialogue: 0,1:01:07.38,1:01:08.70,Default,,0,0,0,,{\pos(962,1016)}Feulion !
Dialogue: 0,1:01:10.58,1:01:16.10,Default,,0,0,0,,{\pos(962,1016)}Quelle sera sa puissance ?\NEst-ce que ce sera celle d'un oni au max ?
Dialogue: 0,1:01:17.70,1:01:20.90,Default,,0,0,0,,{\pos(962,1016)}Puissance max d'un oni !
Dialogue: 0,1:01:23.36,1:01:25.54,Default,,0,0,0,,{\pos(962,1016)}Et voici un bonus !
Dialogue: 0,1:01:25.54,1:01:27.54,Default,,0,0,0,,{\pos(962,1016)}Hein ? Pégaz ?
Dialogue: 0,1:01:39.74,1:01:41.74,Default,,0,0,0,,{\pos(962,1016)}Ça pue !
Dialogue: 0,1:01:47.20,1:01:48.56,Default,,0,0,0,,{\pos(962,1016)}Attention !
Dialogue: 0,1:02:25.22,1:02:27.02,Default,,0,0,0,,{\pos(962,1016)}On l'a eu ?
Dialogue: 0,1:02:27.02,1:02:29.02,Default,,0,0,0,,{\pos(962,1016)}On l'a fait !
Dialogue: 0,1:03:01.20,1:03:02.46,Default,,0,0,0,,{\pos(962,1016)}Qu'est ce que c'est ?
Dialogue: 0,1:03:26.94,1:03:28.04,Default,,0,0,0,,{\pos(962,1016)}C'est-à-dire...
Dialogue: 0,1:03:28.82,1:03:30.70,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que c'est que ça ?
Dialogue: 0,1:03:33.22,1:03:35.80,Default,,0,0,0,,{\pos(962,1016)}Il n'apparaît pas sur le Yo-kaipedia !
Dialogue: 0,1:03:39.08,1:03:42.34,Default,,0,0,0,,{\pos(962,1016)}Quoi qu'il en soit, pour le moment, appelons-le...
Dialogue: 0,1:03:42.48,1:03:44.20,Default,,0,0,0,,{\pos(962,1016)}Morquis !
Dialogue: 0,1:03:44.36,1:03:45.48,Default,,0,0,0,,{\pos(962,1016)}Hein ?!
Dialogue: 0,1:03:45.48,1:03:47.54,Default,,0,0,0,,{\pos(962,1016)}C'est un nom tellement arbitraire !
Dialogue: 0,1:03:47.54,1:03:50.24,Default,,0,0,0,,{\pos(962,1016)}Que diriez-vous de quelque chose de plus adapté à un boss final ?
Dialogue: 0,1:03:52.96,1:03:55.22,Default,,0,0,0,,{\pos(962,1016)}Bon sang. Vraiment...
Dialogue: 0,1:03:57.80,1:03:59.70,Default,,0,0,0,,{\pos(962,1016)}Va les chercher, Morquis.
Dialogue: 0,1:03:59.70,1:04:01.00,Default,,0,0,0,,{\pos(962,1016)}Quoi ? Tu es d'accord avec lui ?
Dialogue: 0,1:04:04.24,1:04:06.00,Default,,0,0,0,,{\pos(962,1016)}Ouah ! Pour de vrai ?!
Dialogue: 0,1:04:05.00,1:04:06.74,Default,,0,0,0,,{\pos(962,1016)}MORQUIS
Dialogue: 0,1:04:12.14,1:04:13.36,Default,,0,0,0,,{\pos(962,1016)}Quoi ? Oh non...
Dialogue: 0,1:04:17.16,1:04:18.16,Default,,0,0,0,,{\pos(962,1016)}Des maquereaux ?
Dialogue: 0,1:04:18.80,1:04:20.14,Default,,0,0,0,,{\pos(962,1016)}Quelle capacité pulmonaire !
Dialogue: 0,1:04:20.18,1:04:21.20,Default,,0,0,0,,{\pos(962,1016)}Quoi ?
Dialogue: 0,1:04:21.20,1:04:22.32,Default,,0,0,0,,{\pos(962,1016)}Hein ?
Dialogue: 0,1:04:30.44,1:04:32.64,Default,,0,0,0,,{\pos(962,1016)}Quoi ? Attends, qu'est-ce que c'est ?
Dialogue: 0,1:04:33.98,1:04:34.80,Default,,0,0,0,,{\pos(962,1016)}Hé !
Dialogue: 0,1:04:34.80,1:04:37.54,Default,,0,0,0,,{\pos(962,1016)}Hé ! C'est trop dangereux ! Arrêtez !
Dialogue: 0,1:04:41.04,1:04:42.40,Default,,0,0,0,,{\pos(962,1016)}Oh mon Dieu... !
Dialogue: 0,1:04:42.40,1:04:44.02,Default,,0,0,0,,{\pos(962,1016)}Une pieuvre pour un seul homme...
Dialogue: 0,1:04:51.34,1:04:52.60,Default,,0,0,0,,{\pos(962,1016)}Que pouvons-nous faire ?
Dialogue: 0,1:04:52.60,1:04:55.14,Default,,0,0,0,,{\pos(962,1016)}Combattons-le dans notre monde !
Dialogue: 0,1:04:55.68,1:04:57.18,Default,,0,0,0,,{\pos(962,1016)}Quoi ? Hein ?
Dialogue: 0,1:04:59.26,1:05:01.28,Default,,0,0,0,,{\pos(962,1016)}Il est là ! Koalanyan !
Dialogue: 0,1:05:15.02,1:05:18.04,Default,,0,0,0,,{\pos(962,1016)}Hé ! N'en faites-vous pas trop avec l'eau !
Dialogue: 0,1:05:23.82,1:05:26.80,Default,,0,0,0,,{\pos(962,1016)}Vas-y Nathan ! Je vais le retenir !
Dialogue: 0,1:05:27.38,1:05:29.70,Default,,0,0,0,,{\pos(962,1016)}Je vais aussi aider.
Dialogue: 0,1:05:29.70,1:05:31.32,Default,,0,0,0,,{\pos(962,1016)}Oui. S'il vous plaît !
Dialogue: 0,1:05:34.52,1:05:37.26,Default,,0,0,0,,{\pos(962,1016)}Attends, Koalanyan !
Dialogue: 0,1:05:39.28,1:05:41.24,Default,,0,0,0,,{\pos(962,1016)}Attends !
Dialogue: 0,1:05:41.24,1:05:44.22,Default,,0,0,0,,{\pos(962,1016)}Koalanyan ! Attends-moi !
Dialogue: 0,1:05:47.18,1:05:48.28,Default,,0,0,0,,{\pos(962,1016)}Oh non !
Dialogue: 0,1:05:55.90,1:05:57.30,Default,,0,0,0,,{\pos(962,1016)}Un billet enfant s'il vous plaît !
Dialogue: 0,1:05:57.38,1:05:58.70,Default,,0,0,0,,{\pos(962,1016)}Que fais-tu ?
Dialogue: 0,1:05:58.76,1:06:00.34,Default,,0,0,0,,{\pos(962,1016)}Je dois acheter un billet !
Dialogue: 0,1:06:00.34,1:06:02.30,Default,,0,0,0,,{\pos(962,1016)}Nous partons devant !
Dialogue: 0,1:06:02.30,1:06:03.84,Default,,0,0,0,,{\pos(962,1016)}D'accord ! Bon courage !
Dialogue: 0,1:06:03.84,1:06:05.84,Default,,0,0,0,,{\pos(962,1016)}Je suis pressé, s'il vous plait !
Dialogue: 0,1:06:10.30,1:06:11.38,Default,,0,0,0,,{\pos(962,1016)}Morquis ?!
Dialogue: 0,1:06:11.38,1:06:13.38,Default,,0,0,0,,{\pos(962,1016)}Depuis quand est-il arrivé là ?!
Dialogue: 0,1:06:20.14,1:06:21.74,Default,,0,0,0,,{\pos(962,1016)}Il va venir ici !
Dialogue: 0,1:06:27.94,1:06:29.46,Default,,0,0,0,,{\pos(962,1016)}Laisse-le moi !
Dialogue: 0,1:06:29.46,1:06:31.46,Default,,0,0,0,,{\pos(962,1016)}Poing rocket !
Dialogue: 0,1:06:39.64,1:06:40.98,Default,,0,0,0,,{\pos(962,1016)}Quel gros poisson... !
Dialogue: 0,1:06:40.98,1:06:42.98,Default,,0,0,0,,{\pos(962,1016)}Mais l'essentiel vous échappe complètement !
Dialogue: 0,1:06:44.04,1:06:45.00,Default,,0,0,0,,{\pos(962,1016)}Attends...
Dialogue: 0,1:06:54.20,1:06:57.10,Default,,0,0,0,,{\pos(962,1016)}Grand frère, dépêche-toi !
Dialogue: 0,1:06:57.10,1:07:01.56,Default,,0,0,0,,{\pos(962,1016)}Applanissement !
Dialogue: 0,1:07:06.38,1:07:08.80,Default,,0,0,0,,{\pos(962,1016)}Par la fureur du chaton !
Dialogue: 0,1:07:15.32,1:07:17.40,Default,,0,0,0,,{\pos(962,1016)}Ça ne sert à rien !
Dialogue: 0,1:07:17.40,1:07:20.18,Default,,0,0,0,,{\pos(962,1016)}Je ne peux pas non plus utiliser mes poings rocket.
Dialogue: 0,1:07:22.16,1:07:25.60,Default,,0,0,0,,{\pos(962,1016)}Vu que nous en sommes là, peut-être que nous pouvons utiliser ça !
Dialogue: 0,1:07:25.82,1:07:27.76,Default,,0,0,0,,{\pos(962,1016)}Char de combat à fabriquer soi-même...
Dialogue: 0,1:07:27.76,1:07:31.10,Default,,0,0,0,,{\pos(962,1016)}Construisons-le pour vaincre le boss final !
Dialogue: 0,1:07:31.20,1:07:32.34,Default,,0,0,0,,{\pos(962,1016)}C'est le premier numéro.
Dialogue: 0,1:07:32.44,1:07:33.84,Default,,0,0,0,,{\pos(962,1016)}C'est plutôt cool !
Dialogue: 0,1:07:56.22,1:07:57.92,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que c'est ?
Dialogue: 0,1:08:01.60,1:08:02.72,Default,,0,0,0,,{\pos(962,1016)}Hé.
Dialogue: 0,1:08:06.34,1:08:09.16,Default,,0,0,0,,{\pos(962,1016)}Il ne prend pas un peu trop de temps ?
Dialogue: 0,1:08:10.32,1:08:12.84,Default,,0,0,0,,{\pos(962,1016)}Ce monde est trop réaliste.
Dialogue: 0,1:08:17.70,1:08:19.72,Default,,0,0,0,,{\pos(962,1016)}Ah ! Il est ici !
Dialogue: 0,1:08:36.86,1:08:39.82,Default,,0,0,0,,{\pos(962,1016)}Cette vieille dame en fait trop avec l'eau...
Dialogue: 0,1:08:49.44,1:08:51.22,Default,,0,0,0,,{\pos(962,1016)}Jibanyan !
Dialogue: 0,1:08:51.22,1:08:52.40,Default,,0,0,0,,{\pos(962,1016)}Hovernyan !
Dialogue: 0,1:08:56.62,1:08:59.60,Default,,0,0,0,,{\pos(962,1016)}Ah ! Ça n'avance pas du tout !
Dialogue: 0,1:09:01.80,1:09:04.04,Default,,0,0,0,,{\pos(962,1016)}Nous l'avons enfin rattrapé !
Dialogue: 0,1:09:04.28,1:09:05.98,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce qu'on fait maintenant ?
Dialogue: 0,1:09:05.98,1:09:07.62,Default,,0,0,0,,{\pos(962,1016)}Appuie-lui sur le nez !
Dialogue: 0,1:09:07.62,1:09:08.86,Default,,0,0,0,,{\pos(962,1016)}D'accord !
Dialogue: 0,1:09:09.38,1:09:11.40,Default,,0,0,0,,{\pos(962,1016)}J'appuie sur quoi, déjà ?
Dialogue: 0,1:09:11.40,1:09:13.40,Default,,0,0,0,,{\pos(962,1016)}Appuie sur n'importe quoi !
Dialogue: 0,1:09:14.20,1:09:15.12,Default,,0,0,0,,{\pos(962,1016)}Bip-nez !
Dialogue: 0,1:09:20.36,1:09:21.78,Default,,0,0,0,,{\pos(962,1016)}Vas-y, Usapyon !
Dialogue: 0,1:09:21.78,1:09:24.70,Default,,0,0,0,,{\pos(962,1016)}Je peux le construire en deux temps trois mouvements !
Dialogue: 0,1:09:26.60,1:09:28.26,Default,,0,0,0,,{\pos(962,1016)}C'est fait !
Dialogue: 0,1:09:29.32,1:09:30.74,Default,,0,0,0,,{\pos(962,1016)}Allons-y !
Dialogue: 0,1:09:46.96,1:09:51.20,Default,,0,0,0,,{\pos(962,1016)}Finissons-en !
Dialogue: 0,1:10:03.72,1:10:05.08,Default,,0,0,0,,{\pos(962,1016)}Nous l'avons fait !
Dialogue: 0,1:10:05.08,1:10:07.18,Default,,0,0,0,,{\pos(962,1016)}Tu l'as fait ! Bon travail, Usapyon !
Dialogue: 0,1:10:07.18,1:10:09.18,Default,,0,0,0,,{\pos(962,1016)}Hé !
Dialogue: 0,1:10:09.18,1:10:10.52,Default,,0,0,0,,{\pos(962,1016)}Komasan !
Dialogue: 0,1:10:10.70,1:10:12.52,Default,,0,0,0,,{\pos(962,1016)}Vous nous avez sauvés !
Dialogue: 0,1:10:18.64,1:10:19.74,Default,,0,0,0,,{\pos(962,1016)}Quoi ?
Dialogue: 0,1:10:23.02,1:10:24.32,Default,,0,0,0,,{\pos(962,1016)}Du thon rouge !
Dialogue: 0,1:10:24.66,1:10:25.86,Default,,0,0,0,,{\pos(962,1016)}Attention !
Dialogue: 0,1:10:26.22,1:10:27.92,Default,,0,0,0,,{\pos(962,1016)}Attention !
Dialogue: 0,1:10:34.20,1:10:36.04,Default,,0,0,0,,{\pos(962,1016)}Komajiro !
Dialogue: 0,1:11:03.88,1:11:05.90,Default,,0,0,0,,{\pos(962,1016)}Il est de plus en plus gros !
Dialogue: 0,1:11:06.84,1:11:08.94,Default,,0,0,0,,{\pos(962,1016)}Qu'allons-nous faire...
Dialogue: 0,1:11:09.02,1:11:10.90,Default,,0,0,0,,{\pos(962,1016)}Ah ! Bien sûr !
Dialogue: 0,1:11:10.90,1:11:12.90,Default,,0,0,0,,{\pos(962,1016)}Essayons d'utiliser ça !
Dialogue: 0,1:11:12.90,1:11:16.92,Default,,0,0,0,,{\pos(962,1016)}Cette potion suspecte fabriquée par cette fille qui ressemble à Ariane !
Dialogue: 0,1:11:18.44,1:11:19.82,Default,,0,0,0,,{\pos(962,1016)}C'est... quoi ?
Dialogue: 0,1:11:21.24,1:11:22.32,Default,,0,0,0,,{\pos(962,1016)}Nous devons la boire.
Dialogue: 0,1:11:23.14,1:11:25.24,Default,,0,0,0,,{\pos(962,1016)}Il est rempli d'ingrédients puissants.
Dialogue: 0,1:11:25.24,1:11:27.82,Default,,0,0,0,,{\pos(962,1016)}La boire augmentera certainement votre force.
Dialogue: 0,1:11:27.84,1:11:29.08,Default,,0,0,0,,{\pos(962,1016)}Pour de vrai ?
Dialogue: 0,1:11:29.08,1:11:30.04,Default,,0,0,0,,{\pos(962,1016)}Oui !
Dialogue: 0,1:11:30.58,1:11:32.48,Default,,0,0,0,,{\pos(962,1016)}Par contre... je ne garantis rien au niveau du goût...
Dialogue: 0,1:11:32.48,1:11:33.68,Default,,0,0,0,,{\pos(962,1016)}Hein ?
Dialogue: 0,1:11:33.68,1:11:35.22,Default,,0,0,0,,{\pos(962,1016)}Du goût ?
Dialogue: 0,1:11:35.46,1:11:38.66,Default,,0,0,0,,{\pos(962,1016)}Bon ! Qui veut un verre ?
Dialogue: 0,1:11:38.94,1:11:40.02,Default,,0,0,0,,{\pos(962,1016)}Moi !
Dialogue: 0,1:11:40.02,1:11:42.36,Default,,0,0,0,,{\pos(962,1016)}Moi aussi ! Moi aussi !
Dialogue: 0,1:11:42.38,1:11:43.42,Default,,0,0,0,,{\pos(962,1016)}Quoi ? Euh...
Dialogue: 0,1:11:43.42,1:11:45.30,Default,,0,0,0,,{\pos(962,1016)}Je le ferai aussi !
Dialogue: 0,1:11:45.30,1:11:46.90,Default,,0,0,0,,{\pos(962,1016)}Je veux aider.
Dialogue: 0,1:11:46.90,1:11:48.58,Default,,0,0,0,,{\pos(962,1016)}Si c'est comme ça,
Dialogue: 0,1:11:48.58,1:11:49.76,Default,,0,0,0,,{\pos(962,1016)}Bien.
Dialogue: 0,1:11:49.96,1:11:50.76,Default,,0,0,0,,{\pos(962,1016)}Tiens.
Dialogue: 0,1:11:59.42,1:12:00.56,Default,,0,0,0,,{\pos(962,1016)}Ne t'inquiète pas.
Dialogue: 0,1:12:00.56,1:12:02.12,Default,,0,0,0,,{\pos(962,1016)}Je suis un robot.
Dialogue: 0,1:12:02.12,1:12:03.82,Default,,0,0,0,,{\pos(962,1016)}Peu importe à quel point c'est dégoûtant...
Dialogue: 0,1:12:09.30,1:12:11.54,Default,,0,0,0,,{\pos(962,1016)}Il est clair que ce produit aura un certain effet.
Dialogue: 0,1:12:11.54,1:12:13.92,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce qu'Ariane a fait ?
Dialogue: 0,1:12:33.42,1:12:35.68,Default,,0,0,0,,{\pos(962,1016)}Oh ! Tout le monde !
Dialogue: 0,1:12:38.66,1:12:40.00,Default,,0,0,0,,{\pos(962,1016)}Quoi ?
Dialogue: 0,1:12:40.60,1:12:43.28,Default,,0,0,0,,{\pos(962,1016)}Est-ce que j'ai si mauvais goût ?
Dialogue: 0,1:12:44.06,1:12:46.26,Default,,0,0,0,,{\pos(962,1016)}Robonyan F...
Dialogue: 0,1:12:53.88,1:12:55.16,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que c'est ?
Dialogue: 0,1:13:03.50,1:13:05.42,Default,,0,0,0,,{\pos(962,1016)}Ensemble avalé !
Dialogue: 0,1:13:05.48,1:13:07.50,Default,,0,0,0,,{\pos(962,1016)}L'ultime Robonyan !
Dialogue: 0,1:13:09.48,1:13:11.50,Default,,0,0,0,,{\pos(962,1016)}ROBONYAN ULTIME
Dialogue: 0,1:13:11.90,1:13:13.32,Default,,0,0,0,,{\pos(962,1016)}Quelle combinaison !
Dialogue: 0,1:13:23.58,1:13:25.26,Default,,0,0,0,,{\pos(962,1016)}Amorçage du système de missiles.
Dialogue: 0,1:13:38.92,1:13:41.76,Default,,0,0,0,,{\pos(962,1016)}On s'est transformés en projectiles !
Dialogue: 0,1:13:42.80,1:13:45.14,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce qu'ils comptent faire ?!
Dialogue: 0,1:13:46.00,1:13:48.26,Default,,0,0,0,,{\pos(962,1016)}Je ne dois pas arrêter de danser !
Dialogue: 0,1:13:53.50,1:13:54.72,Default,,0,0,0,,{\pos(962,1016)}Feu !
Dialogue: 0,1:13:54.72,1:13:56.72,Default,,0,0,0,,{\pos(962,1016)}Oui !
Dialogue: 0,1:14:09.26,1:14:10.64,Default,,0,0,0,,{\pos(962,1016)}Je...
Dialogue: 0,1:14:10.64,1:14:15.16,Default,,0,0,0,,{\pos(962,1016)}Alleeeeeez !
Dialogue: 0,1:14:15.32,1:14:16.78,Default,,0,0,0,,{\pos(962,1016)}Allons-y !
Dialogue: 0,1:14:17.66,1:14:19.32,Default,,0,0,0,,{\pos(962,1016)}Il n'y a qu'un seul monde !
Dialogue: 0,1:14:19.32,1:14:24.36,Default,,0,0,0,,{\pos(962,1016)}Par la fureur de tous les chatons !
Dialogue: 0,1:14:44.88,1:14:46.42,Default,,0,0,0,,{\pos(962,1016)}Je...
Dialogue: 0,1:14:46.78,1:14:48.42,Default,,0,0,0,,{\pos(962,1016)}Je...
Dialogue: 0,1:14:49.00,1:14:50.86,Default,,0,0,0,,{\pos(962,1016)}Je...
Dialogue: 0,1:16:06.56,1:16:08.76,Default,,0,0,0,,{\pos(962,1016)}Kanami...
Dialogue: 0,1:16:09.64,1:16:11.86,Default,,0,0,0,,{\pos(962,1016)}J'ai entendu parler...
Dialogue: 0,1:16:12.52,1:16:14.72,Default,,0,0,0,,{\pos(962,1016)}... de ton école de danse...
Dialogue: 0,1:16:15.32,1:16:17.12,Default,,0,0,0,,{\pos(962,1016)}... à propos de tes jambes.
Dialogue: 0,1:16:21.36,1:16:23.14,Default,,0,0,0,,{\pos(962,1016)}Ce que les médecins ont dit...
Dialogue: 0,1:16:23.26,1:16:25.02,Default,,0,0,0,,{\pos(962,1016)}Si tu travailles à la réadaptation...
Dialogue: 0,1:16:25.02,1:16:27.02,Default,,0,0,0,,{\pos(962,1016)}Tu bougeras à nouveau tes jambes.
Dialogue: 0,1:16:28.84,1:16:31.04,Default,,0,0,0,,{\pos(962,1016)}Ça pourrait prendre du temps....
Dialogue: 0,1:16:31.04,1:16:33.08,Default,,0,0,0,,{\pos(962,1016)}... mais tu pourras à nouveau danser.
Dialogue: 0,1:16:33.16,1:16:35.08,Default,,0,0,0,,{\pos(962,1016)}C'est facile à dire !
Dialogue: 0,1:16:35.08,1:16:37.08,Default,,0,0,0,,{\pos(962,1016)}Qu'est ce que tu sais de moi ?
Dialogue: 0,1:16:37.08,1:16:39.48,Default,,0,0,0,,{\pos(962,1016)}J'ai tout risqué pour la danse !
Dialogue: 0,1:16:39.90,1:16:42.20,Default,,0,0,0,,{\pos(962,1016)}J'ai pratiqué plus que quiconque !
Dialogue: 0,1:16:42.28,1:16:44.06,Default,,0,0,0,,{\pos(962,1016)}C'était mon but.
Dialogue: 0,1:16:45.50,1:16:47.94,Default,,0,0,0,,{\pos(962,1016)}Je ne resterai pas abandonnée dans mon monde,
Dialogue: 0,1:16:48.42,1:16:50.64,Default,,0,0,0,,{\pos(962,1016)}un monde sans espoir pour moi.
Dialogue: 0,1:16:51.90,1:16:54.22,Default,,0,0,0,,{\pos(962,1016)}C'est pourquoi je voulais effacer ce monde.
Dialogue: 0,1:16:56.06,1:16:57.92,Default,,0,0,0,,{\pos(962,1016)}Mais c'est n'importe quoi.
Dialogue: 0,1:16:59.82,1:17:01.20,Default,,0,0,0,,{\pos(962,1016)}Kanami.
Dialogue: 0,1:17:07.22,1:17:08.34,Default,,0,0,0,,{\pos(962,1016)}Kanami...
Dialogue: 0,1:17:08.34,1:17:10.84,Default,,0,0,0,,{\pos(962,1016)}Tu veux effacer tout ce qui est précieux ?
Dialogue: 0,1:17:14.96,1:17:19.96,Default,,0,0,0,,{\pos(962,1016)}Même les sentiments des personnes qui t'ont soutenue ?
Dialogue: 0,1:17:27.22,1:17:29.94,Default,,0,0,0,,{\pos(962,1016)}Madame Sae elle m'a montré...
Dialogue: 0,1:17:30.78,1:17:35.16,Default,,0,0,0,,{\pos(962,1016)}Alors ça... C'est le plan de réadaptation que j'ai élaboré pour elle.
Dialogue: 0,1:17:37.00,1:17:38.94,Default,,0,0,0,,{\pos(962,1016)}Petit à petit.
Dialogue: 0,1:17:39.82,1:17:42.52,Default,,0,0,0,,{\pos(962,1016)}Avec le temps, elle peut surmonter ça.
Dialogue: 0,1:17:43.62,1:17:46.20,Default,,0,0,0,,{\pos(962,1016)}Un jour, elle pourra à nouveau danser.
Dialogue: 0,1:17:48.60,1:17:50.46,Default,,0,0,0,,{\pos(962,1016)}Le but est que...
Dialogue: 0,1:17:50.46,1:17:52.46,Default,,0,0,0,,{\pos(962,1016)}...dans environ 3 ans,
Dialogue: 0,1:17:52.68,1:17:55.10,Default,,0,0,0,,{\pos(962,1016)}elle puisse participer aux championnats nationaux.
Dialogue: 0,1:17:55.94,1:17:58.26,Default,,0,0,0,,{\pos(962,1016)}Ce n'est pas qu'un rêve.
Dialogue: 0,1:18:01.66,1:18:03.10,Default,,0,0,0,,{\pos(962,1016)}Cependant...
Dialogue: 0,1:18:04.06,1:18:06.48,Default,,0,0,0,,{\pos(962,1016)}... C'est à elle de décider...
Dialogue: 0,1:18:06.48,1:18:08.48,Default,,0,0,0,,{\pos(962,1016)}Pour faire le premier pas.
Dialogue: 0,1:18:09.16,1:18:10.96,Default,,0,0,0,,{\pos(962,1016)}Si elle le fait sans enthousiasme...
Dialogue: 0,1:18:11.02,1:18:14.50,Default,,0,0,0,,{\pos(962,1016)}... elle ne pourra pas surmonter le processus de réadaptation.
Dialogue: 0,1:18:17.68,1:18:22.06,Default,,0,0,0,,{\pos(962,1016)}Sa danse... remonte le moral des spectateurs.
Dialogue: 0,1:18:24.36,1:18:27.64,Default,,0,0,0,,{\pos(962,1016)}Et son sourire encourage tout le monde.
Dialogue: 0,1:18:29.08,1:18:32.68,Default,,0,0,0,,{\pos(962,1016)}Elle m'a également rendue très heureuse.
Dialogue: 0,1:18:35.24,1:18:37.16,Default,,0,0,0,,{\pos(962,1016)}Kanami...
Dialogue: 0,1:18:37.82,1:18:39.60,Default,,0,0,0,,{\pos(962,1016)}La danse n'est pas seulement son but.
Dialogue: 0,1:18:40.12,1:18:42.38,Default,,0,0,0,,{\pos(962,1016)}Elle a un don pour ça.
Dialogue: 0,1:18:44.08,1:18:46.52,Default,,0,0,0,,{\pos(962,1016)}Je pensais que si je n'étais pas capable de danser
Dialogue: 0,1:18:47.22,1:18:49.76,Default,,0,0,0,,{\pos(962,1016)}Les gens se séparaient de moi.
Dialogue: 0,1:18:50.46,1:18:52.16,Default,,0,0,0,,{\pos(962,1016)}Vous ne seriez pas séparés.
Dialogue: 0,1:18:52.16,1:18:54.16,Default,,0,0,0,,{\pos(962,1016)}Les gens ne se débarrasseraient pas de toi !
Dialogue: 0,1:18:54.16,1:18:56.16,Default,,0,0,0,,{\pos(962,1016)}C'est toi qui te débarrasse des gens !
Dialogue: 0,1:19:09.56,1:19:10.96,Default,,0,0,0,,{\pos(962,1016)}Kanami...
Dialogue: 0,1:19:10.96,1:19:12.36,Default,,0,0,0,,{\pos(962,1016)}Tu te souviens ?
Dialogue: 0,1:19:12.46,1:19:14.96,Default,,0,0,0,,{\pos(962,1016)}Quand tu t’entraînais dur avec tout le monde ?
Dialogue: 0,1:19:19.88,1:19:21.70,Default,,0,0,0,,{\pos(962,1016)}Je m'appelle Kanami Minami !
Dialogue: 0,1:19:21.70,1:19:23.70,Default,,0,0,0,,{\pos(962,1016)}Enchantée !
Dialogue: 0,1:19:24.24,1:19:26.16,Default,,0,0,0,,{\pos(962,1016)}Nous ferons de notre mieux ensemble !
Dialogue: 0,1:19:40.16,1:19:42.02,Default,,0,0,0,,{\pos(962,1016)}Kanami.
Dialogue: 0,1:19:42.94,1:19:44.86,Default,,0,0,0,,{\pos(962,1016)}On t'attendra.
Dialogue: 0,1:19:55.06,1:19:57.44,Default,,0,0,0,,{\pos(962,1016)}J'étais la seule à avoir abandonné...
Dialogue: 0,1:20:01.32,1:20:03.14,Default,,0,0,0,,{\pos(962,1016)}C'était juste moi...
Dialogue: 0,1:20:33.86,1:20:35.92,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que je faisais pendant tout ce temps ?
Dialogue: 0,1:20:37.82,1:20:40.40,Default,,0,0,0,,{\pos(962,1016)}J'ai oublié quelque chose d'important...
Dialogue: 0,1:20:48.36,1:20:50.62,Default,,0,0,0,,{\pos(962,1016)}C'est grâce à toi que je me souviens.
Dialogue: 0,1:20:52.68,1:20:55.38,Default,,0,0,0,,{\pos(962,1016)}Mon rêve n'est pas seulement le mien.
Dialogue: 0,1:20:56.54,1:20:59.20,Default,,0,0,0,,{\pos(962,1016)}C'est aussi le rêve de ceux qui me soutiennent.
Dialogue: 0,1:21:00.82,1:21:02.22,Default,,0,0,0,,{\pos(962,1016)}Kanami, tu peux le faire.
Dialogue: 0,1:21:02.22,1:21:06.42,Default,,0,0,0,,{\pos(962,1016)}Car tu as le pouvoir de créer un Yo-kai terrifiant.
Dialogue: 0,1:21:06.66,1:21:07.66,Default,,0,0,0,,{\pos(962,1016)}Whisper !
Dialogue: 0,1:21:07.86,1:21:10.44,Default,,0,0,0,,{\pos(962,1016)}Parce que ta danse est si belle !
Dialogue: 0,1:21:10.52,1:21:12.10,Default,,0,0,0,,{\pos(962,1016)}Aucune raison de s'inquiéter !
Dialogue: 0,1:21:17.26,1:21:20.44,Default,,0,0,0,,{\pos(962,1016)}Je suis désolée d'avoir entraîné votre monde là-dedans.
Dialogue: 0,1:21:23.88,1:21:25.56,Default,,0,0,0,,{\pos(962,1016)}Mais c'est fascinant.
Dialogue: 0,1:21:25.56,1:21:29.00,Default,,0,0,0,,{\pos(962,1016)}Je ne pouvais pas croire que tu venais d'un monde différent.
Dialogue: 0,1:21:31.10,1:21:33.14,Default,,0,0,0,,{\pos(962,1016)}Euh... moi aussi.
Dialogue: 0,1:21:33.58,1:21:39.00,Default,,0,0,0,,{\pos(962,1016)}Mais... ce monde a tellement de détails...
Dialogue: 0,1:21:39.96,1:21:43.88,Default,,0,0,0,,{\pos(962,1016)}En d’autres termes, je m’intéresse vraiment aux petits points maintenant.
Dialogue: 0,1:21:44.84,1:21:45.86,Default,,0,0,0,,{\pos(962,1016)}Les pores ?
Dialogue: 0,1:22:32.80,1:22:34.72,Default,,0,0,0,,{\pos(962,1016)}Au revoir, Nathan.
Dialogue: 0,1:22:35.82,1:22:37.70,Default,,0,0,0,,{\pos(962,1016)}Merci beaucoup.
Dialogue: 0,1:23:02.50,1:23:02.92,Default,,0,0,0,,{\pos(962,1016)}Hein ?
Dialogue: 0,1:23:02.92,1:23:05.92,Default,,0,0,0,,{\pos(962,1016)}Barres de chocolat ! Barres de chocolat ! C'est l'heure des barres de chocolat !
Dialogue: 0,1:23:18.46,1:23:20.40,Default,,0,0,0,,{\pos(962,1016)}Nathan ! Qu'est ce que tu regardes ?
Dialogue: 0,1:23:22.62,1:23:23.98,Default,,0,0,0,,{\pos(962,1016)}Rien du tout !
Dialogue: 0,1:23:26.08,1:23:28.52,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que c'est ? Qu'est-ce que c'est ?
Dialogue: 0,1:23:28.66,1:23:31.98,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce que c'est, qu'est-ce que c'est, qu'est-ce que c'est ?
Dialogue: 0,1:23:32.06,1:23:33.96,Default,,0,0,0,,{\pos(962,1016)}Je te l'ai dit, ce n'est rien !
Dialogue: 0,1:23:37.24,1:23:39.44,Default,,0,0,0,,{\pos(962,1016)}Oh ! Depuis quand as-tu ça ?
Dialogue: 0,1:23:39.44,1:23:42.54,Default,,0,0,0,,{\pos(962,1016)}C'est un amour interdit ! Interdit !
Dialogue: 0,1:23:43.68,1:23:45.64,Default,,0,0,0,,{\pos(962,1016)}Comme si j'en avais quelque chose à faire...
Dialogue: 0,1:23:46.38,1:23:48.38,Default,,0,0,0,,{\pos(962,1016)}Mes sentiments pourraient devenir assez forts...
Dialogue: 0,1:23:48.38,1:23:51.90,Default,,0,0,0,,{\pos(962,1016)}...pour relier ce monde à l'autre !
Dialogue: 0,1:23:51.90,1:23:55.16,Default,,0,0,0,,{\pos(962,1016)}Oh bon sang. Qu'est-ce que tu essaies de faire ?
Dialogue: 0,1:23:57.18,1:23:58.16,Default,,0,0,0,,{\pos(962,1016)}Ah !
Dialogue: 0,1:23:58.16,1:23:58.92,Default,,0,0,0,,{\pos(962,1016)}Quoi ?
Dialogue: 0,1:23:58.92,1:24:00.06,Default,,0,0,0,,{\pos(962,1016)}Ton visage ! Ton visage!
Dialogue: 0,1:24:00.06,1:24:02.06,Default,,0,0,0,,{\pos(962,1016)}Ah ! Fuyez !
Dialogue: 0,1:24:03.20,1:24:04.62,Default,,0,0,0,,{\pos(962,1016)}Qu'est-ce qui lui prend ?
Dialogue: 0,1:24:07.54,1:24:09.28,Default,,0,0,0,,{\pos(962,1016)}Ehhhh !
Dialogue: 0,1:24:11.50,1:24:13.02,Default,,0,0,0,,{\pos(962,1016)}Qui est ce vieil homme ?
Dialogue: 0,1:24:13.98,1:24:16.02,Default,,0,0,0,,{\pos(962,1016)}Excusez-moi !
Dialogue: 0,1:29:44.02,1:29:45.18,Default,,0,0,0,,{\pos(962,1016)}Seigneur Enma
Dialogue: 0,1:29:45.80,1:29:48.02,Default,,0,0,0,,{\pos(962,1016)}Et le prochain film ?
Dialogue: 0,1:29:48.02,1:29:49.34,Default,,0,0,0,,{\pos(962,1016)}Je me demande...
Dialogue: 0,1:29:55.06,1:29:59.42,Default,,0,0,0,,{\pos(962,1016)}Quatrième film confirmé publiquement pour l'hiver 2017
